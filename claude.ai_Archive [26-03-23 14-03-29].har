\": \"pubmed\",\n          \"directoryUrl\": \"https://claude.ai/directory/81cc5080-a204-4aa1-a694-fa868a3c8721\",\n          \"claudeCodeExternalLink\": \"https://support.claude.com/en/articles/12614801-using-the-pubmed-connector-in-claude\",\n          \"permissions\": \"Read\",\n          \"useCases\": [\n            \"life-sciences\",\n            \"health\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"publishedOn\": \"Mon Jan 12 2026 16:21:41 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Fri Oct 17 2025 23:17:15 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Mon Jan 12 2026 16:20:17 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"pubmed\",\n          \"backgroundPattern\": \"Loop 4\",\n          \"serverLabel\": \"pubmed.mcp.claude.com/mcp\",\n          \"itemId\": \"68f2ce7b383797a1fe09b7de\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">Provides access to PubMed's biomedical citations and PubMed Central's full-text archive. Search articles, retrieve metadata and abstracts, access full-text content (when available in PMC), find related research, and more.</p><p id=\\\"\\\">You can use the PubMed connector to:<br><br>Search recent publications:<br>\\\"How many cancer research articles have been published this month?\\\"</p><p id=\\\"\\\">Summarize research papers:<br>\\\"Summarize the research paper 'Nucleoporin-mediated regulation of cell identity genes'\\\"</p><p id=\\\"\\\">Query scientific mechanisms:<br>\\\"What is known about the mechanisms of DNA repair including the roles of Rad51 and Brca1 in PubMed?\\\"</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"rank\": 22,\n          \"popularityScore\": 16175,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 64199\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"io.n8n/n8n\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Talk to your n8n instance and trigger automations - Search for workflows, get their details, and execute them directly from Claude\",\n        \"title\": \"n8n\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"{url}\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"d86fa999-100c-4212-ad7f-2fefea661ef1\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"search_workflows\",\n            \"get_workflow_details\",\n            \"execute_workflow\"\n          ],\n          \"promptNames\": [],\n          \"urlRegex\": \"/mcp-server/http\",\n          \"requiredFields\": [\n            {\n              \"field\": \"url\",\n              \"sourceUrl\": \"https://docs.n8n.io/advanced-ai/accessing-n8n-mcp-server/\"\n            }\n          ],\n          \"isAuthless\": false,\n          \"displayName\": \"n8n\",\n          \"oneLiner\": \"Access and run your n8n workflows\",\n          \"iconUrl\": \"https://n8n.io/\",\n          \"documentation\": \"https://docs.n8n.io/advanced-ai/accessing-n8n-mcp-server/\",\n          \"support\": \"mailto:help@n8n.io\",\n          \"privacyPolicy\": \"https://n8n.io/legal/privacy/\",\n          \"author\": {\n            \"name\": \"n8n GmbH\",\n            \"url\": \"https://n8n.io/\"\n          },\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"source\": \"auto-sync\",\n          \"visibil