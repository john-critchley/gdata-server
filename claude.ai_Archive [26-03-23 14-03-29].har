ilTemplate\",\n            \"updateEmailTemplate\",\n            \"getPasswordStrengthConfig\",\n            \"setPasswordStrengthConfig\",\n            \"getConsumerSDKConfig\",\n            \"getB2BSDKConfig\",\n            \"updateConsumerSDKConfig\",\n            \"updateB2BSDKConfig\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Stytch\",\n          \"oneLiner\": \"Manage your Stytch Project\",\n          \"iconUrl\": \"https://stytch.com/\",\n          \"documentation\": \"https://stytch.com/docs/workspace-management/stytch-mcp\",\n          \"support\": \"mailto:support@stytch.com\",\n          \"privacyPolicy\": \"https://stytch.com/legal/privacy-policy\",\n          \"url\": \"https://mcp.stytch.dev/mcp\",\n          \"author\": {\n            \"name\": \"Stytch\",\n            \"url\": \"https://stytch.com/\"\n          },\n          \"slug\": \"stytch\",\n          \"directoryUrl\": \"https://claude.ai/directory/b873d3db-0781-4a3d-9245-9c6213e6d785\",\n          \"permissions\": \"Read\",\n          \"useCases\": [\n            \"code\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\"\n          ],\n          \"publishedOn\": \"Tue Jan 13 2026 20:19:08 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Thu Aug 28 2025 14:02:57 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Tue Jan 13 2026 18:42:54 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"stych\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"mcp.stytch.dev/mcp\",\n          \"itemId\": \"68b06191bb8faebc4d1db630\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">The Stytch connector enables Claude to programmatically manage your Stytch Project like Redirect URLs, Email Templates, and more.</p><p id=\\\"\\\">You can use the Stytch connector to:<br><br>Set up new projects with authentication:<br>\\\"Create a new Stytch consumer project and configure redirect URLs for my web application callback\\\"</p><p id=\\\"\\\">Manage multi-environment configurations:<br>\\\"List all my Stytch projects and synchronize email templates across development, staging, and production\\\"</p><p id=\\\"\\\">Audit security and compliance settings:<br>\\\"Review my password strength configuration and check SDK authentication method settings for compliance\\\"</p><p id=\\\"\\\"></p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"rank\": 165,\n          \"popularityScore\": 10229,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 37504\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.intuit.turbotax/mcp\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Get fast federal tax estimates and discover filing options with Intuit TurboTax-powered tools. Start with a simple tax estimator that guides you through the info you need and see your refund or amount owed as you go. When you're ready for expert help, connect with trusted tax pros. Confident tax filing starts here.\\n\\nBy connecting, you agree to the Intuit TurboTax [Terms of Service](https://www.intuit.com/legal/terms/en-us/turbotax/online-license/) and acknowledge Intuit's [Global Privacy Statement](https://www.intuit.com/privacy/statement/).\",\n        \"title\": \"Intuit TurboTax\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://ai-inc.turbotax.intuit.com/358A1C1B-F73B-46A7-B130-4B14916E6843/v1/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\