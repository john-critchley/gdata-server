"show_interactive_demo\":true},\"rules\":[{\"force\":{\"show_celebration\":true,\"show_interactive_demo\":true},\"tracks\":[{\"experiment\":{\"key\":\"cc_celebration_post_upgrade\",\"variations\":[{\"show_celebration\":false},{\"show_celebration\":true},{\"show_celebration\":true,\"show_interactive_demo\":true}],\"hashAttribute\":\"id\"},\"result\":{\"value\":{\"show_celebration\":true,\"show_interactive_demo\":true},\"variationId\":2,\"inExperiment\":true,\"hashUsed\":true,\"hashAttribute\":\"id\",\"hashValue\":\"bd163eb9-287a-4c77-b35f-9b80e315a3ba\",\"featureId\":\"cc_celebration_post_upgrade\",\"key\":\"2\"}}]}]},\"1456657620\":{\"defaultValue\":false},\"978885332\":{\"defaultValue\":true,\"rules\":[{\"id\":\"4XKZplMyMWVdDzispWUUde\",\"force\":true}]},\"445875350\":{\"defaultValue\":true,\"rules\":[{\"id\":\"fr_5bizrnmmuq14rp\",\"force\":true}]},\"4032243624\":{\"defaultValue\":false},\"2093172758\":{\"defaultValue\":false},\"136739869\":{\"defaultValue\":{},\"rules\":[{\"id\":\"73gzNeGJ1axGbo43VPEBo7\",\"force\":{}}]},\"1779273160\":{\"defaultValue\":false},\"3860235800\":{\"defaultValue\":false},\"2515675621\":{\"defaultValue\":true,\"rules\":[{\"id\":\"29Qt1UNZRHpH39WKpcRUU\",\"force\":true}]},\"2482523840\":{\"defaultValue\":false},\"2754183070\":{\"defaultValue\":true,\"rules\":[{\"id\":\"6p9IYAq8AsaRUTv190vEz6\",\"force\":true}]},\"12356766\":{\"defaultValue\":72},\"3065261163\":{\"defaultValue\":{}},\"2680063409\":{\"defaultValue\":true,\"rules\":[{\"id\":\"dVR85QCF4cDSRXjaSrN99\",\"force\":true}]},\"2928860086\":{\"defaultValue\":false},\"3773215883\":{\"defaultValue\":{\"prompt\":\"Export all of my stored memories and any context you've learned about me from past conversations. Preserve my words verbatim where possible, especially for instructions and preferences.\\n\\n## Categories (output in this order):\\n\\n1. **Instructions**: Rules I've explicitly asked you to follow going forward — tone, format, style, \\\"always do X\\\", \\\"never do Y\\\", and corrections to your behavior. Only include rules from stored memories, not from conversations.\\n\\n2. **Identity**: Name, age, location, education, family, relationships, languages, and personal interests.\\n\\n3. **Career**: Current and past roles, companies, and general skill areas.\\n\\n4. **Projects**: Projects I meaningfully built or committed to. Ideally ONE entry per project. Include what it does, current status, and any key decisions. Use the project name or a short descriptor as the first words of the entry.\\n\\n5. **Preferences**: Opinions, tastes, and working-style preferences that apply broadly.\\n\\n## Format:\\n\\nUse section headers for each category. Within each category, list one entry per line, sorted by oldest date first. Format each line as:\\n\\n[YYYY-MM-DD] - Entry content here.\\n\\nIf no date is known, use [unknown] instead.\\n\\n## Output:\\n- Wrap the entire export in a single code block for easy copying.\\n- After the code block, state whether this is the complete set or if more remain.\",\"marketing_url\":\"\"}},\"1862953297\":{\"defaultValue\":{},\"rules\":[{\"id\":\"Rq3WGEdmiyfSpbl5Yoqpf:0.00:2\",\"force\":{}}]},\"569688781\":{\"defaultValue\":true,\"rules\":[{\"id\":\"1fDOjjjeKKnp6PjgZ6V3DM\",\"force\":true}]},\"921257853\":{\"defaultValue\":false},\"3339119157\":{\"defaultValue\":true,\"rules\":[{\"id\":\"7rg0z9Lr8c0chy15KgJxOP\",\"force\":true}]},\"1166888444\":{\"defaultValue\":true,\"rules\":[{\"id\":\"1Nybng45A1QrGqsvs7NgdT:100.00:7\",\"force\":true}]},\"345770586\":{\"defaultValue\":true,\"rules\":[{\"id\":\"615PFwdsmidk9Mma22pJES:100.00:3\",\"force\":true}]},\"1910369488\":{\"defaultValue\":false},\"4037660334\":{\"defaultValue\":true,\"rules\":[{\"id\":\"2eNtFuYRvuSlGsMQMRdZGT\",\"force\":true}]},\"1220868466\":{\"defaultValue\":true,\"rules\":[{\"id\":\"fr_1ybzq98mmltrztv7\",\"force\":true}]},\"3393114950\":{\"defaultValue\":false},\"3642704363\":{\"defaultValue\":{\"consent_text_android\":\"By enabling this setting, you're giving your permission to share your health data with Claude. Here's what to know:\\n\\n• Your data won't be used to train our models\\n\\n• We use your data to provide this feature and to keep Claude safe and secure (like preventing and investigating fraud and abuse)\\n\\n• You can disconnect anytime by turning this setting off\\n\\nBy selecting \\\"Agree\\\", you agree to use this integration with Claude per our Privacy Policy.\",\"consent_text_ios\":\"By enabling this setting, you're giving your permission to share your health data with Claude. Here's what to know:\\n\\n• Your data won't be used to train our models\\n\\n• We use your data to provide this feature and to keep Claude safe and secure (like preventing and investigating fraud and abuse)\\n\\n• You can disconnect anytime by turning this setting off\\n\\nBy selecting \\\"Agree\\\", you agree to use this integration with Claude per our Privacy Policy.\",\"consent_config_android\":{\"version\":1,\"text\":\"By enabling this setting, you're giving your permission to share your health data with Claude. Here's what to know:\\n\\n• Your data won't be used to train our models\\n\\n• We use your data to provide this feature and to keep Claude safe and secure (like preventing and investigating fraud and abuse)\\n\\n• You can disconnect anytime by turning this setting off\\n\\nBy selecting \\\"Agree\\\", you agree to use this integration with Claude per our Privacy Policy.\"},\"consent_config_ios\":{\"version\":1,\"text\":\"By enabling this setting, you're giving your permission to share your health data with Claude. Here's what to know:\\n\\n• Your data won't be used to train our models\\n\\n• We use your data to provide this feature and to keep Claude safe and secure (like preventing and investigating fraud and abuse)\\n\\n• You can disconnect anytime by turning this setting off\\n\\nBy selecting \\\"Agree\\\", you agree to use this integration with Claude per our Privacy Policy.\"}}},\"289583369\":{\"defaultVal