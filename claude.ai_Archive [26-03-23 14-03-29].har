         \"name\": \"Indeed\",\n            \"url\": \"https://www.indeed.com/\"\n          },\n          \"slug\": \"indeed\",\n          \"directoryUrl\": \"https://claude.ai/directory/78cb9092-b837-4439-845d-fdccd5723e7f\",\n          \"permissions\": \"Read\",\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\"\n          ],\n          \"publishedOn\": \"Mon Jan 12 2026 16:21:41 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Fri Sep 12 2025 22:47:45 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Mon Jan 12 2026 16:20:15 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"indeed\",\n          \"backgroundPattern\": \"Loop 3\",\n          \"serverLabel\": \"mcp.indeed.com/claude/mcp\",\n          \"itemId\": \"68c4a311c82308a962aed16c\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">Search and retrieve job listings, access detailed job descriptions and requirements, and provide direct job links to users. This streamlines the job search process by bringing Indeed's extensive job database and company information directly into conversations with Claude, enabling more seamless career exploration, job searching, and employment research capabilities.<br><br>You can use the Indeed connector to:<br><br>Match jobs to your resume:<br>\\\"Find good roles for me based on my uploaded resume\\\"</p><p id=\\\"\\\">Search with specific criteria:<br>\\\"Find me product manager jobs in Austin, requiring minimum 7 years experience and API design as a skill\\\"</p><p id=\\\"\\\">Find flexible opportunities:<br>\\\"Find part-time jobs for me with flexible schedules\\\"</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"useCases\": [\n            \"productivity\"\n          