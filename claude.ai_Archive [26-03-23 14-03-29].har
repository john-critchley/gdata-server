          \"popularityScore\": 15224,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 61673,\n          \"sortOrder\": 1\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"io.apollo/mcp\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Connect Apollo to Claude so you can prospect and take action from a single conversation. Search Apollo's database to find the right people and companies, then enrich records to reveal verified contact details when you're ready. Create or update contacts, and add or remove contacts from existing sequences to keep outbound moving.\",\n        \"title\": \"Apollo.io\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.apollo.io/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"8fd555a4-ea5f-49cf-9335-582dd6760597\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"apollo_enrich_organization\",\n            \"apollo_enrich_person\",\n            \"apollo_bulk_enrich_people\",\n            \"apollo_search_people\",\n            \"apollo_search_organizations\",\n            \"apollo_search_contacts\",\n            \"apollo_get_job_postings\",\n            \"apollo_create_contacts\",\n            \"apollo_update_contacts\",\n            \"apollo_search_sequences\",\n            \"apollo_add_contacts_to_sequence\",\n            \"apollo_remove_contacts_from_sequence\",\n            \"apollo_list_email_accounts\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Apollo.io\",\n          \"oneLiner\": \"Find buyers. Book more meetings. Close more deals.\",\n          \"iconUrl\": \"https://www.apollo.io\",\n          \"documentation\": \"https://knowledge.apollo.io/hc/en-us/articles/43827318678541-Integrate-Apollo-with-Claude\",\n          \"support\": \"https://www.apollo.io/submit-a-request\",\n          \"privacyPolicy\": \"https://www.apollo.io/privacy-policy\",\n          \"url\": \"https://mcp.apollo.io/mcp\",\n          \"author\": {\n            \"name\": \"Apollo.io\",\n            \"url\": \"https://www.apollo.io\"\n          },\n          \"slug\": \"apollo\",\n          \"directoryUrl\": \"https://claude.ai/directory/8fd555a4-ea5f-49cf-9335-582dd6760597\",\n          \"worksWith\": [\n            \"claude\"\n          ],\n          \"logo\": \"apollo\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"mcp.apollo.io/mcp\",\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-02-20\",\n          \"useCases\": [\n            \"sales-and-marketing\"\n          ],\n          \"permissions\": \"Read and write\",\n          \"rank\": 36,\n          \"popularityScore\": 15170,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 97064\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"$schema\": \"https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json\",\n        \"name\": \"com.cloudflare.mcp/mcp\",\n        \"description\": \"Enables users to build applications on Cloudflare Workers using built-in storage, AI, and compute primitives. Deploy code to production, create and query databases, manage KV stores, and more.\",\n        \"repository\": {\n          \"url\": \"https://github.com/cloudflare/mcp-server-cloudflare\",\n          \"source\": \"github\"\n        },\n        \"version\": \"1.0.0\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://bindings.mcp.cloudflare.com/mcp\"\n          }\n        ],\n        \"title\": \"Cloudflare Developer Platform\"\n      },\n      \"_meta\": {\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"publishedAt\": \"2025-09-16T22:06:29.987729Z\",\n          \"updatedAt\": \"2025-09-16T22:06:29.987729Z\",\n          \"isLatest\": true\n        },\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"2d60210c-dd92-4be0-b09c-3662f10445c9\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"accounts_list\",\n            \"set_active_account\",\n            \"kv_namespaces_list\",\n            \"kv_namespace_create\",\n            \"kv_namespace_delete\",\n            \"kv_namespace_get\",\n            \"kv_namespace_update\",\n            \"workers_list\",\n            \"workers_get_worker\",\n            \"workers_get_worker_code\",\n            \"r2_buckets_list\",\n            \"r2_bucket_create\",\n            \"r2_bucket_get\",\n            \"r2_bucket_delete\",\n            \"d1_databases_list\",\n            \"d1_database_create\",\n            \"d1_database_delete\",\n            \"d1_database_get\",\n            \"d1_database_query\",\n            \"hyperdrive_configs_list\",\n            \"hyperdrive_config_create\",\n            \"hyperdrive_config_delete\",\n            \"hyperdrive_config_get\",\n            \"hyperdrive_config_edit\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Cloudflare Developer Platform\",\n          \"oneLiner\": \"Build applications with compute, storage, and AI\",\n          \"iconUrl\": \"https://bindings.mcp.cloudflare.com/mcp\",\n          \"documentation\": \"https://www.support.cloudflare.com/\",\n          \"support\": \"https://github.com/cloudflare/mcp-server-cloudflare/tree/main/apps/workers-bindings\",\n          \"privacyPolicy\": \"https://www.cloudflare.com/privacypolicy/\",\n          \"url\": \"https://bindings.mcp.cloudflare.com/mcp\",\n          \"author\": {\n            \"name\": \"Cloudflare\",\n            \"url\": \"https://cloudflare.com\"\n          },\n          \"slug\": \"cloudflare\",\n          \"directoryUrl\": \"http://claude.ai/directory/2d60210c-dd92-4be0-b09c-3662f10445c9\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http cloudflare https://bindings.mcp.cloudflare.com/mcp\",\n          \"permissions\": \"Read and write\",\n          \"useCases\": [\n            \"code\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"publishedOn\": \"Fri Jan 16 2026 19:33:48 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Thu Aug 28 2025 14:02:54 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Fri Jan 16 2026 19:32:45 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"cloudflare\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"bindings.mcp.cloudflare.com/mcp\",\n          \"itemId\": \"68b0618e97a6a7e363bef13c\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">Manage Workers deployments, D1 databases, R2 storage, and KV stores directly through Claude. Access real-time logs, configure security rules, monitor performance metrics, and deploy applications using Cloudflare’s edge infrastructure, all through natural language commands for streamlined development workflows.<br><br>You can use the Cloudflare connector to:<br><br>Deploy code to production:<br>\\\"Deploy code to Worker called 'my-project'\\\"</p><p id=\\\"\\\">Create KV storage:<br>\\\"Create a new KV namespace called 'my-kv-store'\\\"</p><p id=\\\"\\\">Query databases:<br>\\\"Run the query 'SELECT * FROM customers LIMIT 10;' on D1 database 'YOUR_D1_DB_ID'\\\"</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"rank\": 37,\n          \"popularityScore\": 15151,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 61079,\n          \"sortOrder\": 1\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"ai.deepsense.mcp/clinical-trials\",\n        \"version\": \"1.0.0\",\n        \"description\": \"The Clinical Trials Connector gives Claude access to ClinicalTrials.gov, the NIH/NLM registry of FDA-regulated clinical studies conducted worldwide.\",\n        \"title\": \"Clinical Trials\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.deepsense.ai/clinical_trials/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"c1754944-3ad1-49ab-bec5-9aeae3a6a9a3\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"get_trial_details\",\n            \"search_by_eligibility\",\n            \"analyze_endpoints\",\n            \"search_investigators\",\n            \"search_trials\",\n            \"search_by_sponsor\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": true,\n          \"oneLiner\": \"Access ClinicalTrials.gov data\",\n          \"iconUrl\": \"https://clinicaltrials.gov/\",\n          \"documentation\": \"https://docs.mcp.deepsense.ai/guides/clinical_trials.html\",\n          \"support\": \"mailto:mcp.support@deepsense.ai\",\n          \"privacyPolicy\": \"https://deepsense.ai/privacy-policy/\",\n          \"author\": {\n            \"name\": \"deepsense.ai\",\n            \"url\": \"https://deepsense.ai\"\n          },\n          \"slug\": \"clinical-trials\",\n          \"permissions\": \"Read\",\n          \"useCases\": [\n            \"life-sciences\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-code\"\n          ],\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-01-07\",\n          \"rank\": 38,\n          \"popularityScore\": 15115,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 58885\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.zoominfo.mcp/zoominfo\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Access ZoomInfo's GTM intelligence to ground your AI workflows with verified B2B data. Search companies and identify key stakeholders with natural language. Enrich with 300+ data points, build targeted account lists, and drive momentum from first touch to renewal.\",\n        \"title\": \"ZoomInfo\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.zoominfo.com/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"f2cdf1b8-2f75-48a4-8d8c-8d9cce1b8643\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"search_contacts\",\n            \"enrich_contact\",\n            \"search_companies\",\n            \"enrich_company\",\n            \"lookup\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"ZoomInfo\",\n          \"oneLiner\": \"Enrich contacts & accounts with GTM intelligence\",\n          \"iconUrl\": \"https://www.zoominfo.com/\",\n          \"documentation\": \"https://docs.zoominfo.com/docs/zi-api-mcp-overview/\",\n          \"support\": \"mailto:integrationsupport@zoominfo.com\",\n          \"privacyPolicy\": \"https://www.zoominfo.com/legal/privacy-policy\",\n          \"url\": \"https://mcp.zoominfo.com/mcp\",\n          \"author\": {\n            \"name\": \"ZoomInfo Technologies Inc.\",\n            \"url\": \"https://www.zoominfo.com/\"\n          },\n          \"slug\": \"zoominfo\",\n          \"directoryUrl\": \"https://claude.ai/directory/f2cdf1b8-2f75-48a4-8d8c-8d9cce1b8643\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http zoominfo https://mcp.zoominfo.com/mcp\",\n          \"permissions\": \"Read and write\",\n          \"useCases\": [\n            \"sales-and-marketing\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"publishedOn\": \"Mon Jan 12 2026 16:21:41 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Wed Sep 24 2025 23:50:18 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Mon Jan 12 2026 16:20:17 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"zoominfo\",\n          \"serverLabel\": \"mcp.zoominfo.com/mcp\",\n          \"itemId\": \"68d483baad18a21c45f63df0\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">Access ZoomInfo's GTM intelligence to ground your AI workflows with verified B2B data. Search companies and identify key stakeholders with natural language. Enrich with 300+ data points, build targeted account lists, and drive momentum from first touch to renewal.</p><p id=\\\"\\\">You can use the ZoomInfo connector to:<br><br>Search for target companies:<br>\\\"Find publicly listed tech companies in the USA with over $1B in revenue, selling primarily to revenue operations and sales leadership\\\"</p><p id=\\\"\\\">Find specific contacts at companies:<br>\\\"Find me product operations managers at Acme Co who have been with the company more than one year, and enrich with their email addresses\\\"</p><p id=\\\"\\\">Build enriched prospect lists:<br>\\\"Search for Chief Revenue Officers at fintech companies in the Bay Area between $50M-$250M in revenue, then enrich the top ten candidates with verified email and phone\\\"</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"rank\": 39,\n          \"popularityScore\": 15040,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 76430\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.pitchbook.mcp.premium/pitchbook-premium\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Bring the depth of PitchBook's industry-leading private capital market intelligence into Claude. Powered by our MCP server, PitchBook clients can seamlessly search and analyze firms, deals, funds, and key players—unlocking trusted insights for confident decisions, actionable intelligence, and market benchmarking, all within their AI workflows.\",\n        \"title\": \"PitchBook Premium\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://premium.mcp.pitchbook.com/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"79c545e3-8878-4557-bcbb-3add11c86890\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"pitchbook_search\",\n            \"pitchbook_get_profile\",\n            \"pitchbook_get_company_deals\",\n            \"pitchbook_get_company_investors\",\n            \"pitchbook_get_company_financials\",\n            \"pitchbook_get_investor_investments\",\n            \"pitchbook_get_deal_participants\",\n            \"pitchbook_get_deal_cap_table\",\n            \"pitchbook_get_team_members\",\n            \"pitchbook_get_fund_lp_commitments\",\n            \"pitchbook_get_investor_funds\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"PitchBook Premium\",\n          \"oneLiner\": \"PitchBook data, embedded in the way you work.\",\n          \"iconUrl\": \"https://www.pitchbook.com\",\n          \"documentation\": \"https://help.pitchbook.com/s/article/PitchBook-Premium-for-Claude-by-Anthropic\",\n          \"support\": \"mailto:support@pitchbook.com\",\n          \"privacyPolicy\": \"https://pitchbook.com/privacy-policy\",\n          \"url\": \"https://premium.mcp.pitchbook.com/mcp\",\n          \"author\": {\n            \"name\": \"PitchBook\",\n            \"url\": \"https://www.pitchbook.com\"\n          },\n          \"slug\": \"pitchbook\",\n          \"directoryUrl\": \"https://claude.ai/directory/79c545e3-8878-4557-bcbb-3add11c86890\",\n          \"claudeApiCopyText\": \"https://premium.mcp.pitchbook.com/mcp\",\n          \"permissions\": \"Read\",\n          \"useCases\": [\n            \"financial-services\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\"\n          ],\n          \"publishedOn\": \"Mon Jan 12 2026 16:21:41 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Wed Oct 22 2025 16:49:42 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Mon Jan 12 2026 16:20:13 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"pitchbook\",\n          \"serverLabel\": \"premium.mcp.pitchbook.com/mcp\",\n          \"itemId\": \"68f90b263f65596eace9bc40\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">Bring the depth of PitchBook’s industry-leading private capital market intelligence into Claude. Powered by our MCP server, PitchBook clients can seamlessly search and analyze firms, deals, funds, and key players—unlocking trusted insights for confident decisions, actionable intelligence, and market benchmarking, all within their AI workflows.</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"rank\": 40,\n          \"popularityScore\": 15036,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 57230\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.wordpress.public-api/wordpress-com\",\n        \"version\": \"1.0.0\",\n        \"description\": \"The WordPress.com MCP server allows AI assistants to securely interact with your WordPress.com sites. It exposes tools for listing, searching, and viewing posts, pages, and comments, managing users and site settings, and retrieving statistics. By leveraging OAuth 2.1, it ensures that agents only access resources you've approved, making it easy to integrate AI-driven workflows into your publishing experience.\",\n        \"title\": \"WordPress.com\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://public-api.wordpress.com/wpcom/v2/mcp/v1\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"e6fc4c18-ea48-4752-9912-7a13bf9999ed\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"user-profile\",\n            \"user-sites\",\n            \"user-domains\",\n            \"user-achievements\",\n            \"user-connections\",\n            \"user-notifications\",\n            \"user-notifications-inbox\",\n            \"user-security\",\n            \"user-subscriptions\",\n            \"site-users\",\n            \"posts-search\",\n            \"post-get\",\n            \"site-comments-search\",\n            \"site-plugins\",\n            \"site-settings\",\n            \"site-statistics\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"oneLiner\": \"Secure AI access to manage your WordPress.com sites\",\n          \"iconUrl\": \"https://wordpress.com\",\n          \"documentation\": \"https://developer.wordpress.com/docs/mcp/\",\n          \"support\": \"https://wordpress.com/support\",\n          \"privacyPolicy\": \"https://automattic.com/privacy\",\n          \"author\": {\n            \"name\": \"Automattic (WordPress.com)\",\n            \"url\": \"https://wordpress.com\"\n          },\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-01-23\",\n          \"useCases\": [\n            \"productivity\"\n          ],\n          \"rank\": 41,\n          \"popularityScore\": 15012,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 79732,\n          \"sortOrder\": 1\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.smartsheet/mcp\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Make Smartsheet a native part of your AI workflow. Ask Claude to analyze project timelines, create graphs to summarize your sheet information, all through conversation. The Smartsheet connector eliminates manual data entry and repetitive updates, letting you focus on decisions while Claude handles the details. Transform how you manage projects with AI that understands your Smartsheet data and can act on it.\",\n        \"title\": \"Smartsheet\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"{url}\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"688b7b3f-efc4-45a6-83af-d2760ef9e96f\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"search\",\n            \"list_workspaces\",\n            \"get_sheet_summary\",\n            \"create_sheet_in_workspace\",\n            \"add_rows\",\n            \"update_rows\",\n            \"delete_rows\",\n            \"get_columns\",\n            \"add_columns\",\n            \"update_column\",\n            \"delete_column\"\n          ],\n          \"promptNames\": [],\n          \"urlRegex\": \"^https://mcp\\\\.smartsheet\\\\.(com|eu|au)/?$\",\n          \"requiredFields\": [\n            {\n              \"field\": \"url\",\n              \"sourceUrl\": \"https://help.smartsheet.com/articles/2483656-install-smartsheet-connector-claude#toc-get-started\"\n            }\n          ],\n          \"isAuthless\": false,\n          \"displayName\": \"Smartsheet\",\n          \"oneLiner\": \"Analyze and manage Smartsheet data with Claude\",\n          \"iconUrl\": \"https://www.smartsheet.com\",\n          \"documentation\": \"https://help.smartsheet.com/articles/2483663-use-smartsheet-connector-claude\",\n          \"support\": \"https://help.smartsheet.com/contact\",\n          \"privacyPolicy\": \"https://www.smartsheet.com/legal/privacy\",\n          \"url\": \"{url}\",\n          \"author\": {\n            \"name\": \"Smartsheet Inc.\",\n            \"url\": \"https://www.smartsheet.com/\"\n          },\n          \"slug\": \"smartsheet\",\n          \"directoryUrl\": \"https://claude.ai/directory/688b7b3f-efc4-45a6-83af-d2760ef9e96f\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http smartsheet {url}\\n\",\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"logo\": \"smartsheet\",\n          \"backgroundPattern\": \"Line 1\",\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-01-29\",\n          \"useCases\": [\n            \"productivity\",\n            \"communication\"\n          ],\n          \"rank\": 42,\n          \"popularityScore\": 14904,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 59852,\n          \"sortOrder\": 1\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"ai.scholargateway.connector/scholar-gateway\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Scholar Gateway enables Claude to generate responses grounded in peer-reviewed sources with verifiable citations and DOI links. The Scholar Gateway Connector searches current literature from Wiley journals and research databases to deliver evidence-backed answers with complete source metadata. This enables you to verify that claims are backed with sourced research — ensuring your Claude-assisted research meets professional research standards.\\n\\nNote: The Scholar Gateway Connector provides access to Wiley content only, additional publisher sources will be added soon. Authentication required, please reach out to Wiley at scholargateway@wiley.com.\",\n        \"title\": \"Scholar Gateway\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://connector.scholargateway.ai/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"ff091334-0f12-4d0e-a973-c00467dd3818\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"Semantic Search\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Scholar Gateway\",\n          \"oneLiner\": \"Enhance responses with scholarly research and citations\",\n          \"iconUrl\": \"https://scholargateway.ai/\",\n          \"documentation\": \"https://docs.scholargateway.ai\",\n          \"support\": \"http://support.scholargateway.ai/\",\n          \"privacyPolicy\": \"https://www.wiley.com/privacy\",\n          \"url\": \"https://connector.scholargateway.ai/mcp\",\n          \"author\": {\n            \"name\": \"John Wiley & Sons Inc.\",\n            \"url\": \"https://www.wiley.com/\"\n          },\n          \"slug\": \"scholar-gateway\",\n          \"directoryUrl\": \"https://claude.ai/directory/ff091334-0f12-4d0e-a973-c00467dd3818\",\n          \"claudeCodeExternalLink\": \"https://support.claude.com/en/articles/12614815-using-the-scholar-gateway-connector-in-claude\",\n          \"permissions\": \"Read\",\n          \"useCases\": [\n            \"life-sciences\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"publishedOn\": \"Sat Jan 17 2026 02:21:02 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Tue Oct 14 2025 18:17:09 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Sat Jan 17 2026 02:21:02 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"scholarly-gateway\",\n          \"backgroundPattern\": \"Loop 4\",\n          \"serverLabel\": \"connector.scholargateway.ai/mcp\",\n          \"itemId\": \"68ee93a52ef6bbd5cae3bbe5\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">Enhance responses with scholarly research and citations. The Scholar Gateway Connector grounds Claude's responses in peer-reviewed sources with verifiable citations and DOI links, helping you ensure your Claude-assisted research meets professional research standards.<br></p><p id=\\\"\\\">You can use the Scholar Gateway connector to:</p><p>Support literature reviews and academic writing:<br>\\\"I'm researching marine ecosystem responses to microplastic pollution. Find recent studies from 2021–2025 on detection methods, uptake mechanisms, and ecosystem impacts. What does current research tell us about these areas? Provide citations so I can dig deeper into the sources\\\"</p><p id=\\\"\\\">Strengthen grant proposals with recent research:<br>\\\"I'm writing a grant proposal on developing next-generation battery technologies for energy storage. What does recent research (2022–2025) tell us about solid-state batteries, particularly their safety advantages and manufacturing challenges?\\\"</p><p id=\\\"\\\">Find cross-disciplinary research connections:<br>\\\"I'm a researcher working on clean energy policy effectiveness. What does recent research tell us about why people choose (or don't choose) to adopt renewable energy like solar panels? Please include studies from behavioral economics, psychology, and policy research from 2020–2025\\\"</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"rank\": 43,\n          \"popularityScore\": 14881,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 51006\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.airtable/mcp\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Bring operational data and context into the flow of your Claude conversations. You can ask questions, create and update records, and analyze your data—all through conversation. Use the data in Airtable as input to the work you're doing in Claude, like building a landing page using content you've organized in Airtable. Make quick updates to Airtable without leaving the chat. Airtable for Claude is ideal anytime you need quick access to structured internal data to inform your conversation.\",\n        \"title\": \"Airtable\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.airtable.com/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"cb504fab-e494-490f-bff8-bb3ab23a2209\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"create_records_for_table\",\n            \"get_table_schema\",\n            \"list_bases\",\n            \"list_records_for_table\",\n            \"list_tables_for_base\",\n            \"ping\",\n            \"search_bases\",\n            \"update_records_for_table\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Airtable\",\n          \"oneLiner\": \"Bring your structured data to Claude\",\n          \"iconUrl\": \"https://airtable.com/\",\n          \"documentation\": \"https://support.airtable.com/docs/using-the-airtable-mcp-server\",\n          \"support\": \"https://support.airtable.com/docs/contacting-airtable-support\",\n          \"privacyPolicy\": \"https://www.airtable.com/company/terms-and-policies\",\n          \"url\": \"https://mcp.airtable.com/mcp\",\n          \"author\": {\n            \"name\": \"Airtable\",\n            \"url\": \"https://airtable.com/\"\n          },\n          \"slug\": \"airtable\",\n          \"directoryUrl\": \"https://claude.ai/directory/cb504fab-e494-490f-bff8-bb3ab23a2209\",\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\"\n          ],\n          \"logo\": \"airtable\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"mcp.airtable.com/mcp\",\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"useCases\": [\n            \"data\"\n          ],\n          \"permissions\": \"Read and write\",\n          \"added_at\": \"2026-02-26\",\n          \"rank\": 44,\n          \"popularityScore\": 14802,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 123553,\n          \"sortOrder\": 1\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.ramp.ramp-mcp-remote/ramp\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Enables secure, read-only access to Ramp data for customer-defined logic. Supports loading and querying transactions, reimbursements, bills, purchase orders, cards, vendors, and more, enabling dynamic data fetching and analysis via Claude.\",\n        \"title\": \"Ramp\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://ramp-mcp-remote.ramp.com/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"61bac03c-3f98-4b3c-affb-1b99533fa82c\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"execute_query\",\n            \"clear_table\",\n            \"load_spend_export\",\n            \"load_spend_exports\",\n            \"load_purchase_orders\",\n            \"load_cards\",\n            \"load_limits\",\n            \"load_entities\",\n            \"load_departments\",\n            \"load_users\",\n            \"load_memos\",\n            \"load_locations\",\n            \"load_spend_programs\",\n            \"load_vendors\",\n            \"get_ramp_categories\",\n            \"submit_feedback\",\n            \"get_current_user\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Ramp\",\n    