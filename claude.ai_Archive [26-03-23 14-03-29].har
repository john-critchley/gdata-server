45ee-a45c-2dc56d4ccad6\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"find_companies\",\n            \"get_company_subsidiaries\",\n            \"get_monthly_headcount\",\n            \"analyze_employee_growth\",\n            \"breakdown_by_job_function\",\n            \"analyze_seniority_levels\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Aura\",\n          \"oneLiner\": \"Company intelligence & workforce analytics\",\n          \"iconUrl\": \"https://mcp.auraintelligence.com/mcp\",\n          \"documentation\": \"https://docs.getaura.ai/\",\n          \"support\": \"mailto:support@auraintel.com\",\n          \"privacyPolicy\": \"https://aura-public-assets.s3.us-east-1.amazonaws.com/policies/privacy/aura-privacy-policy-v1.0-20250218.pdf\",\n          \"url\": \"https://mcp.auraintelligence.com/mcp\",\n          \"author\": {\n            \"name\": \"Aura Intelligence\",\n            \"url\": \"https://www.getaura.ai/\"\n          },\n          \"slug\": \"aura\",\n          \"directoryUrl\": \"https://claude.ai/directory/d5415d15-420c-45ee-a45c-2dc56d4ccad6\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http auraintelligence https://mcp.auraintelligence.com/mcp\",\n          \"permissions\": \"Read\",\n          \"useCases\": [\n            \"data\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-code\"\n          ],\n          \"publishedOn\": \"Tue Jan 13 2026 20:19:08 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Fri Sep 12 2025 22:45:41 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Tue Jan 13 2026 18:42:45 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"aura\",\n          \"backgroundPattern\": \"Loop 1\",\n          \"serverLabel\": \"mcp.auraintelligence.com/mcp\",\n          \"itemId\": \"68c4a29542335ae91a9a598f\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">Enable users to search company databases, analyze employee headcount trends, track hiring and attrition rates, explore corporate structures, and benchmark workforce metrics across industries.<br><br>You can use the Aura connector to do:<br><br>Investment Due Diligence:<br>\\\"Analyze Salesforce’s workforce growth over the past 12 months. Break down their employee distribution by department and compare their hiring velocity to other major SaaS companies like HubSpot and Zendesk.\\\"<br>‍</p><p id=\\\"\\\">Competitive Sales Intelligence:<br>“Find detailed information about JPMorgan Chase, including their subsidiary structure, current workforce size, and recent hiring trends in their technology divisions.”<br>‍</p><p id=\\\"\\\">Talent Market Analysis:<br>“Compare employee growth rates and attrition patterns between Google, Meta, and Amazon over the last 6 months, focusing on engineering and product management functions.”<br></p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"rank\": 156,\n          \"popularityScore\": 10792,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 37912\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.melon.mcp/melon\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Explore a variety of Melon charts, get personalized music recommendations just for you, and discover your listening habits. All in one place. You can even play songs directly in the Melon app.\\n • Browse detailed information about artists, albums, and tracks.\\n • Search for songs and playlists using Melon charts and trending keywords.\\n • Enjoy personalized recommendations based on the songs you love and listen to most. The service is currently available in Korean only.\\n An English version is scheduled to be made available within this year, with an anticipated release in October.\",\n        \"title\": \"Melon\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.melon.com/mcp/\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"02224ef2-6652-422e-9a70-fa93f699ab8f\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"chart_get\",\n            \"detail_get_playlist_songs\",\n            \"detail_get_content\",\n            \"detail_get_artist_songs\",\n            \"detail_get_artist_albums\",\n            \"detail_get_musicstory\",\n            \"detail_get_content_detail_url\",\n            \"genre_get_main_genres\",\n            \"genre_get_sub_genres\",\n            \"genre_get_content\",\n            \"mymusic_get_recent_content\",\n            \"mymusic_get_playlists\",\n            \"mymusic_get_most_listened_songs\",\n            \"mymusic_get_liked_list\",\n            \"mymusic_get_fan_artists_with_temperature\",\n            \"mymusic_get_my_fan_artist_temperature_history\",\n            \"newest_get_content\",\n            \"player_play_content\",\n            \"playlist_get_recommended\",\n            \"search_content\",\n            \"search_get_suggestions\",\n            \"search_musicstories\",\n            \"recomm_dj_mallang_songs\",\n            \"recomm_similar_songs\",\n            \"report_streaming_card\",\n            \"report_streaming_total\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Melon\",\n          \"oneLiner\": \"Browse music charts & your personalized music picks\",\n          \"iconUrl\": \"https://www.melon.com/index.htm\",\n  