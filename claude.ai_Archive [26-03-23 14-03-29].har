p-registry\": {\n          \"uuid\": \"0929a5c7-38ce-40ab-8aad-af9ce34553c7\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"list_databases\",\n            \"list_shares\",\n            \"list_tables\",\n            \"list_columns\",\n            \"search_catalog\",\n            \"query\",\n            \"ask_docs_question\",\n            \"query_rw\",\n            \"get_dive_guide\",\n            \"save_dive\",\n            \"read_dive\",\n            \"update_dive\",\n            \"delete_dive\",\n            \"list_dives\",\n            \"share_dive_data\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"MotherDuck\",\n          \"oneLiner\": \"Get answers from your data\",\n          \"iconUrl\": \"https://motherduck.com/\",\n          \"documentation\": \"https://motherduck.com/docs/sql-reference/mcp/\",\n          \"support\": \"https://motherduck.com/docs/troubleshooting/support/\",\n          \"privacyPolicy\": \"https://motherduck.com/privacy-policy/\",\n          \"url\": \"https://api.motherduck.com/mcp\",\n          \"author\": {\n            \"name\": \"MotherDuck Corporation\",\n            \"url\": \"https://motherduck.com/\"\n          },\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-01-13\",\n          \"useCases\": [\n            \"data\"\n          ],\n          \"permissions\": \"Read and write\",\n          \"rank\": 134,\n          \"popularityScore\": 11625,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 42940\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.tldraw/tldraw\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Draw and diagram while you work with tldraw + Claude. Ask for a flowchart, architecture diagram, wireframe, or mind map and it appears. Edit it, and the AI sees your changes in real time, building on them, refining them, or using them as a starting point for other tasks.\",\n        \"title\": \"tldraw\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://tldraw-mcp-app.tldraw.workers.dev/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"02795770-2c02-42fe-888f-26769ca324a0\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"diagram_drawing_read_me\",\n            \"create_shapes\",\n            \"update_shapes\",\n            \"delete_shapes\",\n            \"read_checkpoint\",\n            \"save_checkpoint\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": true,\n          \"displayName\": \"tldraw\",\n          \"oneLiner\": \"Let Claude sketch, draw, and diagram with you\",\n          \"iconUrl\": \"https://www.tldraw.com\",\n          \"documentation\": \"https://tldraw.notion.site/tldraw-mcp-app\",\n          \"support\": \"https://github.com/tldraw/tldraw/issues\",\n          \"privacyPolicy\": \"https://www.tldraw.com/privacy.html\",\n          \"url\": \"https://tldraw-mcp-app.tldraw.workers.dev/mcp\",\n          \"author\": {\n            \"name\": \"tldraw\",\n            \"url\": \"https://www.tldraw.dev\"\n          },\n          \"slug\": \"tldraw\",\n          \"directoryUrl\": \"https://claude.ai/directory/02795770-2c02-42fe-888f-26769ca324a0\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http tldraw https://tldraw-mcp-app.tldraw.workers.dev/mcp\\n\",\n          \"permissions\": \"Read and write\",\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-desktop\"\n          ],\n          \"logo\": \"tldraw\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"tldraw-mcp-app.tldraw.workers.dev/mcp\",\n          \"hasMcpApp\": true,\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"useCases\": [\n            \"productivity\",\n            \"design\"\n          ],\n          \"added_at\": \"2026-03-13\",\n          \"imageUrls\": [\n            {\n              \"prompt\": \"Can you show me a visual explanation of how tldraw calculates arrow curves?\",\n              \"imageUrl\": \"https://storage.googleapis.com/media-assets-299d7136-cb52-d546-ee02-34bc1307c35f/mcp-directory/carousel/App%20Tldraw%20Card%203.png\"\n            },\n            {\n              \"prompt\": \"Draw me a blank canvas\",\n              \"imageUrl\": \"https://storage.googleapis.com/media-assets-299d7136-cb52-d546-ee02-34bc1307c35f/mcp-directory/carousel/App%20Tldraw%20Card%202.png\"\n            },\n            {\n              \"prompt\": \"Draw me a bird\",\n              \"imageUrl\": \"https://storage.googleapis.com/media-assets-299d7136-cb52-d546-ee02-34bc1307c35f/mcp-directory/carousel/App%20Tldraw%20Card%201.png\"\n            }\n          ],\n          \"rank\": 135,\n          \"popularityScore\": 11615,\n          \"scoreVersion\": \"v1\"\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.anthropic.api.mcp.gdrive/google-drive\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Connect Google Drive to Claude to search through your documents, read file contents, upload new files, and analyze your data. Claude can find specific documents even when you don't remember the exact name, read and analyze the content of Google Docs, Sheets, Slides, and PDFs, and upload files directly to your Drive. Useful for finding project notes, extracting data from spreadsheets, preparing meeting materials, or organizing files scattered across your Drive.\",\n        \"title\": \"Google Drive\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://api.anthropic.com/mcp/gdrive/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"4d7181c6-9480-4427-8a62-ecd4a4198a8f\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"fetch\",\n            \"list_recent\",\n            \"query_search\",\n            \"get_permissions\",\n            \"upload\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"oneLiner\": \"Search, read, and upload files instantly\",\n          \"iconUrl\": \"https://t0.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=https://drive.google.com&size=64\",\n          \"documentation\": \"https://support.anthropic.com/en/articles/10166901-using-the-google-drive-integration\",\n          \"support\": \"https://support.anthropic.com\",\n          \"privacyPolicy\": \"https://www.anthropic.com/privacy\",\n          \"author\": {\n            \"name\": \"Anthropic\",\n            \"url\": \"https://anthropic.com\"\n          },\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"visibility\": [\n            \"gsuite\",\n            \"commercial\"\n          ],\n          \"source\": \"manual\",\n          \"added_at\": \"2026-01-06\",\n          \"useCases\": [\n            \"productivity\",\n            \"data\"\n          ],\n          \"rank\": 136,\n          \"popularityScore\": 11560,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 34957,\n          \"sortOrder\": 0\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.magicpatterns.mcp/magic-patterns\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Discuss and iterate on Magic Patterns designs directly from Claude. Magic Patterns is an AI agent specialized in frontend design.\",\n        \"title\": \"Magic Patterns\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.magicpatterns.com/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"088e0355-cb01-44fa-ba0b-23525fde8d5a\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"get_design\",\n            \"read_files\",\n            \"update_design\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Magic Patterns\",\n          \"oneLiner\": \"Discuss and iterate on Magic Patterns designs\",\n          \"iconUrl\": \"https://www.magicpatterns.com\",\n          \"documentation\": \"https://www.magicpatterns.com/docs/documentation/features/mcp-server/overview\",\n          \"support\": \"mailto:support@magicpatterns.com\",\n          \"privacyPolicy\": \"https://www.magicpatterns.com/docs/documentation/legal/privacy\",\n          \"url\": \"https://mcp.magicpatterns.com/mcp\",\n          \"author\": {\n            \"name\": \"Magic Patterns\",\n            \"url\": \"https://www.magicpatterns.com\"\n          },\n          \"slug\": \"magic-patterns\",\n          \"directoryUrl\": \"https://claude.ai/directory/088e0355-cb01-44fa-ba0b-23525fde8d5a\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http magic-patterns https://mcp.magicpatterns.com/mcp\\n\",\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"logo\": \"magic-patterns\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"mcp.magicpatterns.com/mcp\",\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-02-03\",\n          \"useCases\": [\n            \"productivity\"\n          ],\n          \"rank\": 137,\n          \"popularityScore\": 11559,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 52401\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"ai.day/day-ai\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Day AI is an AI-Native CRM that transforms emails, chats and meetings into richly-structured CRM data, stored in an LLM-optimized format for seamless and deep, relevant context retrieval. Use this Connector to give Claude direct access to your richly-structured customer data, enabling intelligent automation and decision-making grounded in real customer context.\",\n        \"title\": \"Day AI\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://day.ai/api/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"87d31b20-90c3-42ca-94a7-51270953869d\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"open_sidebar\",\n            \"get_share_url\",\n            \"analyze_before_create_or_update\",\n            \"create_or_update_person_organization\",\n            \"create_or_update_opportunity\",\n            \"create_or_update_pipeline_stage\",\n            \"update_property_definition\",\n            \"read_crm_schema\",\n            \"read_object_history\",\n            \"search_related_objects\",\n            \"create_email_draft\",\n            \"send_email\",\n            \"create_page\",\n            \"update_page\",\n            \"create_view\",\n            \"keyword_search\",\n            \"create_action\",\n            \"get_assistant_actions\",\n            \"web_search\",\n            \"send_notification\",\n            \"dismiss_objects\",\n            \"update_assistant\",\n            \"create_custom_property\",\n            \"create_chart\",\n            \"backfill_custom_property\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Day AI\",\n          \"oneLiner\": \"Know everything about your prospects & customers with CRMx\",\n          \"iconUrl\": \"https://day.ai\",\n          \"documentation\": \"https://day.ai/mcp\",\n          \"support\": \"mailto:support@day.ai\",\n          \"privacyPolicy\": \"https://day.ai/privacy\",\n          \"url\": \"https://day.ai/api/mcp\",\n          \"author\": {\n            \"name\": \"Day AI\",\n            \"url\": \"https://day.ai\"\n          },\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"useCases\": [\n            \"productivity\",\n            \"sales-and-marketing\",\n            \"communication\"\n          ],\n          \"rank\": 138,\n          \"popularityScore\": 11507,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 19481\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"pe.chronograph.ai/chronograph\",\n        \"version\": \"1.0.0\",\n        \"description\": \"The Chronograph MCP server allows users to query portfolio data, analyze investments, search for entities, retrieve performance metrics, and access Chronograph's help documentation. The connector is designed for private investment workflows, providing programmatic access to portfolio analytics and reporting data.\",\n        \"title\": \"Chronograph\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://ai.chronograph.pe/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"01744591-790c-471b-9452-f338eff230af\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"query-help-center-documentation\",\n            \"get-help-center-article\",\n            \"top-exposures\",\n            \"run-query\",\n            \"entity-search\",\n            \"commitment-history\",\n            \"investment-metrics\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Chronograph\",\n          \"oneLiner\": \"Interact with your Chronograph data directly in Claude\",\n          \"iconUrl\": \"https://www.chronograph.pe/\",\n          \"documentation\": \"https://lp-help.chronograph.pe/article/735-chronograph-mcp\",\n          \"support\": \"mailto:client.services@chronograph.pe\",\n          \"privacyPolicy\": \"https://www.chronograph.pe/legal/privacy-policy/\",\n          \"url\": \"https://ai.chronograph.pe/mcp\",\n          \"author\": {\n            \"name\": \"Chronograph\",\n            \"url\": \"https://www.chronograph.pe/\"\n          },\n          \"slug\": \"chronograph\",\n          \"directoryUrl\": \"https://claude.ai/directory/01744591-790c-471b-9452-f338eff230af\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http chronograph https://ai.chronograph.pe/mcp\",\n          \"claudeApiCopyText\": \"https://ai.chronograph.pe/mcp\",\n          \"permissions\": \"Read\",\n          \"useCases\": [\n            \"financial-services\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"publishedOn\": \"Mon Jan 12 2026 16:21:41 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Fri Oct 24 2025 19:48:42 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Mon Jan 12 2026 16:20:15 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"chronograph\",\n          \"serverLabel\": \"ai.chronograph.pe/mcp\",\n          \"itemId\": \"68fbd81a3d569c900eca5a2f\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">The Chronograph connector allows users to query portfolio data, analyze investments, search for entities, retrieve performance metrics, and access Chronograph's help documentation. The connector is designed for private investment workflows, providing programmatic access to portfolio analytics and reporting data.</p><p id=\\\"\\\">You can use the Chronograph connector to do:<br><br>Portfolio Exposure Analysis:<br>\\\"What are my top exposures to Health Care within the Client A portfolio?\\\"</p><p id=\\\"\\\">Sector-Based Fund Search:<br>\\\"Which of my funds have exposure to Consumer Finance?\\\"</p><p id=\\\"\\\">Fund Performance Analysis:<br>\\\"What is the performance track record of Huron Oak Equity V?\\\"<br></p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"rank\": 139,\n          \"popularityScore\": 11460,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 50894\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.aiera.mcp-pub/aiera\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Access to Aiera's financial data APIs, including live events, filings, company publications, and much more.\",\n        \"title\": \"Aiera\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp-pub.aiera.com/\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"4ef6cb78-9212-4b0e-b067-bb30e4d27a6f\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"get_available_indexes\",\n            \"get_index_constituents\",\n            \"get_sectors_and_subsectors\",\n            \"find_events\",\n            \"get_event\",\n            \"get_upcoming_events\",\n            \"find_equities\",\n            \"get_equity_summaries\",\n            \"find_filings\",\n            \"get_filing\",\n            \"get_available_watchlists\",\n            \"get_watchlist_constituents\",\n            \"find_company_docs\",\n            \"get_company_doc\",\n            \"get_company_doc_categories\",\n            \"get_company_doc_keywords\",\n            \"find_third_bridge_events\",\n            \"get_third_bridge_event\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Aiera\",\n          \"oneLiner\": \"Live events, filings, company publications, and more\",\n          \"iconUrl\": \"https://www.aiera.com\",\n          \"documentation\": \"https://rest.aiera.com/docs/mcp\",\n          \"support\": \"https://support.aiera.com/\",\n          \"privacyPolicy\": \"https://aiera.com/privacy-policy/\",\n          \"url\": \"https://mcp-pub.aiera.com/\",\n          \"author\": {\n            \"name\": \"Aiera\",\n            \"url\": \"https://www.aiera.com\"\n          },\n          \"slug\": \"aiera\",\n          \"directoryUrl\": \"https://claude.ai/directory/4ef6cb78-9212-4b0e-b067-bb30e4d27a6f\",\n          \"permissions\": \"Read\",\n          \"useCases\": [\n            \"financial-services\"\n          ],\n          \"worksWith\": [\n            \"claude\"\n          ],\n          \"publishedOn\": \"Mon Jan 12 2026 16:21:41 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Fri Oct 24 2025 19:53:22 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Mon Jan 12 2026 16:20:17 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"aiera\",\n          \"serverLabel\": \"mcp-pub.aiera.com/\",\n          \"itemId\": \"68fbd932a431ec59e477cffe\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">Access Aiera's comprehensive financial data APIs, including live earnings calls and investor events, SEC filings, company press releases, ESG reports, and analyst insights. Stay ahead of market-moving information with real-time access to corporate events and financial disclosures.</p><p id=\\\"\\\">You can use the Aiera connector to:<br>‍<br>Track upcoming corporate events:<br>\\\"Are any of the companies in the S&amp;P 500 hosting events this week?\\\"</p><p id=\\\"\\\">Analyze earnings call content:<br>\\\"What are the key analyst questions in the most recent Amazon earnings call?\\\"</p><p id=\\\"\\\">Monitor ESG publications:<br>\\\"Any new ESG publications this week from the Russell 1000?\\\"</p><p id=\\\"\\\">Compare financial filings:<br>\\\"Can you grab the last two Netflix 10-Qs and build me a table comparing reported metrics?\\\"</p><p id=\\\"\\\">Monitor watchlist events:<br>\\\"Are any companies in my primary watchlist hosting events this month?\\\"</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"rank\": 140,\n          \"popularityScore\": 11432,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 37748\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.activecampaign/activecampaign\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Connect ActiveCampaign to Claude for autonomous marketing at your fingertips. Get real-time marketing insights and then take action, instantly. With this secure connection, you can manage lists, tags, contacts, and automations just by chatting with Claude. Ask Claude to pull yesterday’s email performance, get a contact’s phone number, create a new tag, or start an automation. All of that and more, fueled by the ActiveCampaign MCP Server.\",\n        \"title\": \"ActiveCampaign\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"{url}\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"adf5273a-9e9f-414c-a213-2b64a4aa36ae\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"list_contacts\",\n            \"get_contact\",\n            \"create_or_update_contact\",\n            \"list_tags\",\n            \"get_tag\",\n            \"create_contact_tag\",\n            \"add_tag_to_contact\",\n            \"list_lists\",\n            \"get_list\",\n            \"create_list\",\n            \"update_list\",\n            \"add_contact_to_list\",\n            \"list_contact_custom_fields\",\n            \"get_contact_custom_field\",\n            \"create_contact_custom_field\",\n            \"create_field_options\",\n            \"create_contact_field_relationship\",\n            \"list_contact_field_values\",\n            \"get_contact_field_value\",\n            \"create_contact_field_value\",\n            \"update_contact_f