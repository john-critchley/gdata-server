            "text": "{\"_lastModified\":\"2026-03-19T06:16:32.651Z\",\"integrations\":{\"Facebook Conversions API (Actions)\":{\"versionSettings\":{\"componentTypes\":[]},\"consentSettings\":{\"categories\":[\"marketing\"]}},\"Facebook Pixel\":{\"automaticConfiguration\":false,\"blacklistPiiProperties\":[{\"propertyName\":\"title\",\"hashProperty\":false},{\"propertyName\":\"account_uuid\",\"hashProperty\":false},{\"propertyName\":\"organization_uuid\",\"hashProperty\":false},{\"propertyName\":\"billing_type\",\"hashProperty\":false},{\"propertyName\":\"surface\",\"hashProperty\":false},{\"propertyName\":\"version\",\"hashProperty\":false},{\"propertyName\":\"dl\",\"hashProperty\":true}],\"contentTypes\":{},\"initWithExistingTraits\":true,\"keyForExternalId\":\"email\",\"legacyEvents\":{},\"limitedDataUse\":true,\"pixelId\":\"468742119653388\",\"standardEvents\":{\"payment_state_success\":\"Purchase\",\"mobile.iap.pro.store_view.purchase.success\":\"Purchase\"},\"standardEventsCustomProperties\":[],\"userIdAsExternalId\":true,\"valueIdentifier\":\"value\",\"whitelistPiiProperties\":[\"email\",\"userAgent\",\"country\"],\"versionSettings\":{\"version\":\"2.11.5\",\"componentTypes\":[\"browser\"]},\"type\":\"browser\",\"consentSettings\":{\"categories\":[\"marketing\"]},\"bundlingStatus\":\"bundled\"},\"LinkedIn Conversions API\":{\"versionSettings\":{\"componentTypes\":[]},\"consentSettings\":{\"categories\":[\"marketing\"]}},\"Iterable (Actions)\":{\"versionSettings\":{\"componentTypes\":[]},\"consentSettings\":{\"categories\":[\"analytics\",\"marketing\"]}},\"Google Enhanced Conversions\":{\"versionSettings\":{\"componentTypes\":[]},\"consentSettings\":{\"categories\":[\"marketing\"]}},\"Webhook\":{\"versionSettings\":{\"componentTypes\":[]},\"consentSettings\":{\"categories\":[\"analytics\",\"marketing\",\"necessary\"]}},\"Actions Amplitude\":{\"versionSettings\":{\"componentTypes\":[]},\"consentSettings\":{\"categories\":[\"analytics\",\"marketing\",\"necessary\"