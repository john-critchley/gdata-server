,\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.microsoft/microsoft-learn-mcp\",\n        \"version\": \"1.0.0\",\n        \"description\": \"The Microsoft Learn MCP Server enables clients like GitHub Copilot and other AI agents to bring trusted and up-to-date information directly from Microsoft's official documentation. It is a remote MCP server that uses streamable http. It allows to search through documentation, fetch a complete article, and search through code samples.\",\n        \"title\": \"Microsoft Learn\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://learn.microsoft.com/api/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"89a7ddf5-2a6b-410c-be11-aa0e1a1b35a6\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"microsoft_docs_search\",\n            \"microsoft_docs_fetch\",\n            \"microsoft_code_sample_search\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": true,\n          \"displayName\": \"Microsoft Learn\",\n          \"oneLiner\": \"Search trusted Microsoft docs to power your development\",\n          \"iconUrl\": \"https://learn.microsoft.com/en-us/\",\n          \"documentation\": \"https://learn.microsoft.com/en-us/training/support/mcp\",\n          \"support\": \"https://github.com/MicrosoftDocs/mcp/issues\",\n          \"privacyPolicy\": \"https://www.microsoft.com/en-us/privacy/privacystatement\",\n          \"url\": \"https://learn.microsoft.com/api/mcp\",\n          \"author\": {\n            \"name\": \"Microsoft\",\n            \"url\": \"https://learn.microsoft.com/en-us/\"\n          },\n          \"slug\": \"microsoft-learn\",\n          \"directoryUrl\": \"https://claude.ai/dire