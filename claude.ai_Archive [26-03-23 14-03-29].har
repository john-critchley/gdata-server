escription\": \"Access structured first-party IR data from over 14,000 public companies across 65 markets. The Quartr API delivers live and recorded earnings calls, real-time and historical transcripts with speaker identification, slide presentations, filings, reports, and event summaries. Best-in-class reliability and timeliness. All delivered through a single, unified REST API. Query by ticker, ISIN, date, or market. Ideal for financial research, investment analysis, and building data-driven workflows on top of institutional-grade public company data.\",\n        \"title\": \"Quartr\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.quartr.com/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"ac8e4b2a-1618-4b6f-8756-660eb7583ebe\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"search_companies\",\n            \"get_company\",\n            \"list_companies\",\n            \"list_related_companies\",\n            \"list_events\",\n            \"get_event\",\n            \"list_event_types\",\n            \"list_documents\",\n            \"read_document\",\n            \"read_live_transcript\",\n            \"search_documents\",\n            \"get_financials\",\n            \"get_document_summary\",\n            \"get_event_summary\",\n            \"list_watchlists\",\n            \"get_watchlist\",\n            \"create_watchlist\",\n            \"rename_watchlist\",\n            \"delete_watchlist\",\n            \"add_to_watchlist\",\n            \"remove_from_watchlist\",\n            \"list_keywords\",\n            \"create_keyword\",\n            \"update_keyword\",\n            \"delete_keyword\",\n            \"list_folders\",\n            \"create_folder\",\n            \"rename_folder\",\n            \"delete_folder\",\n            \"list_workspaces\",\n            \"create_workspace\",\n            \"delete_workspace\",\n            \"tag_company_to_workspace\",\n            \"untag_company_from_workspace\",\n            \"list_search_filters\",\n            \"create_search_filter\",\n            \"delete_search_filter\",\n            \"list_gics\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Quartr\",\n          \"oneLiner\": \"Financial data and AI infrastructure for company research.\",\n          \"iconUrl\": \"https://quartr.com/\",\n          \"documentation\": \"https://mcp.quartr.com/docs\",\n          \"support\": \"https://quartr.com/contact\",\n          \"privacyPolicy\": \"https://quartr.com/terms-of-service/privacy-policy\",\n          \"url\": \"https://mcp.quartr.com/mcp\",\n          \"author\": {\n            \"name\": \"Quartr\",\n            \"url\": \"https://quartr.com/\"\n          },\n          \"slug\": \"quartr\",\n          \"directoryUrl\": \"https://claude.ai/directory/ac8e4b2a-1618-4b6f-8756-660eb7583ebe\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http quartr https://mcp.quartr.com/mcp\\n\",\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"logo\": \"quartr\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"mcp.quartr.com/mcp\",\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"useCases\": [\n            \"financial-services\"\n          ],\n          \"permissions\": \"Read and write\",\n          \"added_at\": \"2026-03-18\",\n          \"rank\": 179,\n          \"popularityScore\": 9050,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 433309\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.airwallex/developer-mcp\",\n        \"version\": \"1.0.0\",\n        \"description\": \"The Airwallex Developer Model Context Protocol (MCP) server helps developers to easily integrate with Airwallex capabilities by bringing Airwallex documentation, API references, and sandbox testing tools directly to Claude. Enjoy developer lifecycle support from knowledge search, to troubleshooting, to simulations and go-live testing. Use your sandbox credentials to get started!\",\n        \"title\": \"Airwallex Developer\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp-demo.airwallex.com/developer\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"f9e2f745-d688-42a7-8c79-98fe7990dc03\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"create_transfer\",\n            \"list_transfers\",\n            \"simulate_transfer_result\",\n            \"list_beneficiaries\",\n            \"get_fx_quote\",\n            \"list_global_accounts\",\n            \"get_balances\",\n            \"simulate_create_deposit\",\n            \"create_payment_link\",\n            \"list_payment_links\",\n            \"search_public_docs\",\n            \"read_integration_best_practices\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Airwallex Developer\",\n          \"oneLiner\": \"Integrate with the Airwallex Platform using Claude\",\n          \"iconUrl\": \"https://www.airwallex.com/\",\n          \"documentation\": \"https://www.airwallex.com/docs/developer-tools/ai/developer-mcp\",\n          \"support\": \"mailto:developer.support@airwallex.com\",\n          \"privacyPolicy\": \"https://www.airwallex.com/terms/privacy-policy\",\n          \"url\": \"https://mcp-demo.airwallex.com/developer\",\n          \"author\": {\n            \"name\": \"Airwallex\",\n            \"url\": \"https://www.airwallex.com/\"\n          },\n          \"slug\": \"airwallex-developer\",\n          \"directoryUrl\": \"https://claude.ai/directory/f9e2f745-d688-42a7-8c79-98fe7990dc03\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http airwallex-developer https://mcp-demo.airwallex.com/developer\\n\",\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"logo\": \"airwallex-developer\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"mcp-demo.airwallex.com/developer\",\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"useCases\": [\n            \"financial-services\"\n          ],\n          \"permissions\": \"Read and write\",\n          \"added_at\": \"2026-02-26\",\n          \"rank\": 180,\n          \"popularityScore\": 8895,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 131302\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.benchling/benchling\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Benchling is the leading R&D platform that unifies scientific data, automation, and AI so teams can move faster and discover more. This extension connects to Benchling AI, making a customer's Benchling data securely accessible directly in Claude. This means scientists, informaticians, and R&D leaders can ask Claude questions that draw on their Benchling data, then receive clear summaries with links back to the underlying source for full traceability. To use, you must have Deep Research and the Deep Research API enabled in your Benchling account.\",\n        \"title\": \"Benchling\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"{url}\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"b69522d1-0a10-415a-898b-4e4d706c9c87\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"benchling_ask\",\n            \"benchling_deep_research\"\n          ],\n          \"promptNames\": [],\n          \"urlRegex\": \"https://([a-zA-Z0-9-]+).mcp.benchling.com/mcp\",\n          \"requiredFields\": [\n            {\n              \"field\": \"url\",\n              \"sourceUrl\": \"https://help.benchling.com/hc/en-us/articles/40342713479437-Benchling-MCP\"\n            }\n          ],\n          \"isAuthless\": false,\n          \"displayName\": \"Benchling\",\n          \"oneLiner\": \"Connect to R&D data, source experiments, and notebooks\",\n          \"iconUrl\": \"https://cdn.prod.website-files.com/68a44d4040f98a4adf2207b6/690abdfc622a31cabb4ed418_Benchling.jpg\",\n          \"documentation\": \"https://help.benchling.com/hc/en-us/articles/40342713479437-Benchling-MCP\",\n          \"support\": \"https://help.benchling.com/hc/en-us/requests/new\",\n          \"privacyPolicy\": \"https://www.benchling.com/privacy-policy\",\n          \"author\": {\n            \"name\": \"Benchling\",\n            \"url\": \"https://benchling.com/\"\n          },\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"useCases\": [\n            \"life-sciences\"\n          ],\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-01-08\",\n          \"rank\": 181,\n          \"popularityScore\": 8794,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 28184\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.grantedai/mcp\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Search virtually every grant opportunity in existence - federal, state, and private foundation - using natural language. Most databases cover the big programs. Granted also surfaces the long tail: niche state grants, small family foundations, and hyper-local opportunities that nonprofits never find because no single database indexes them all. Research 133,000 US foundations with IRS 990 financials and key officers. Analyze 7 million federal award records to see who's actually winning.\",\n        \"title\": \"Granted\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://grantedai.com/api/mcp/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"59156499-2b9f-42b9-8438-8994d7ce5dad\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"search_grants\",\n            \"get_grant\",\n            \"search_funders\",\n            \"get_funder\",\n            \"get_past_winners\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": true,\n          \"displayName\": \"Granted\",\n          \"oneLiner\": \"Discover every grant opportunity in existence.\",\n          \"iconUrl\": \"https://grantedai.com\",\n          \"documentation\": \"https://grantedai.com/mcp\",\n          \"support\": \"mailto:info@grantedai.com\",\n          \"privacyPolicy\": \"https://grantedai.com/privacy\",\n          \"url\": \"https://grantedai.com/api/mcp/mcp\",\n          \"author\": {\n            \"name\": \"Granted AI\",\n            \"url\": \"https://grantedai.com/\"\n          },\n          \"slug\": \"granted\",\n          \"directoryUrl\": \"https://claude.ai/directory/59156499-2b9f-42b9-8438-8994d7ce5dad\",\n          \"claudeCodeCopyText\": \"clau