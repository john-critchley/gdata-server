erver\": {\n        \"name\": \"io.modelcontextprotocol/server-pdf\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Demo interactive PDF viewer that renders PDFs from a limited set of allowed URLs (e.g., arxiv.org) for security reasons.\",\n        \"title\": \"PDF Viewer\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://example-server.modelcontextprotocol.io/pdf/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"a6f1af7d-e85f-4775-bbfb-da7a8eb990db\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"display_pdf\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"PDF Viewer\",\n          \"oneLiner\": \"Demo PDF viewer that renders PDFs from allowed URLs like arxiv.org\",\n          \"iconUrl\": \"https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/refs/heads/main/blog/static/favicon.svg\",\n          \"documentation\": \"https://github.com/modelcontextprotocol/ext-apps/blob/main/examples/pdf-server/README.md\",\n          \"support\": \"https://github.com/modelcontextprotocol/ext-apps/issues\",\n          \"privacyPolicy\": \"https://lfprojects.org/policies/privacy-policy/\",\n          \"url\": \"https://example-server.modelcontextprotocol.io/pdf/mcp\",\n          \"author\": {\n            \"name\": \"Model Context Protocol Community\",\n            \"url\": \"https://modelcontextprotocol.io\"\n          },\n          \"slug\": \"pdf-viewer\",\n          \"directoryUrl\": \"https://claude.ai/directory/a6f1af7d-e85f-4775-bbfb-da7a8eb990db\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http pdf-viewer https://example-server.modelcontextprotocol.io/pdf/mcp\\n\",\n          \"worksWith\": [\n            \"claude\"\n          ],\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-01-23\",\n          \"useCases\": [\n            \"productivity\"\n          ],\n          \"rank\": 60,\n          \"popularityScore\": 14181,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 73319\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"ai.deepsense.mcp/cms-coverage\",\n        \"version\": \"1.0.0\",\n        \"description\": \"The CMS Coverage Connector gives Claude access to Medicare Part B coverage policies from the CMS Coverage Database, including National Coverage Determinations (NCDs) and Local Coverage Determinations (LCDs).\\n\\nThis server may return data governed by third-party license agreements, including those available here: https://api.coverage.cms.gov/v1/metadata/license-agreement/. By connecting to this server, you understand and agree to abide by any applicable agreements.\",\n        \"title\": \"CMS Coverage\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.deepsense.ai/cms_coverage/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"57dd8e8a-f030-4bb7-a9ed-4098933bd70b\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"get_contractors\",\n            \"get_ncd\",\n            \"sad_exclusion_list\",\n            \"search_articles\",\n            \"search_lcds\",\n            \"search_nca_cals\",\n            \"search_ncds\",\n            \"whats_new_national\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": true,\n          \"oneLiner\": \"Access the CMS Coverage Database\",\n          \"iconUrl\": \"https://www.cms.gov/medicare/coverage/determination-process/basics\",\n          \"documentation\": \"https://docs.mcp.deepsense.ai/guides/cms_coverage.html\",\n          \"support\": \"mailto:mcp.support@deepsense.ai\",\n          \"privacyPolicy\": \"https://deepsense.ai/privacy-policy/\",\n          \"author\": {\n            \"name\": \"deepsense.ai\",\n            \"url\": \"https://deepsense.ai\"\n          },\n          \"slug\": \"cms-coverage\",\n          \"permissions\": \"Read\",\n          \"useCases\": [\n            \"health\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-code\"\n          ],\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-01-07\",\n          \"rank\": 61,\n          \"popularityScore\": 14173,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 50703\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"io.github.PostHog/mcp\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Connect to PostHog and work with your product data through natural conversation. Query analytics using HogQL or natural language, build and manage dashboards and insights, control feature flags, run and monitor experiments, create and analyze surveys, track errors, explore logs, and monitor LLM costs. Results include inline charts so you can visualize trends without leaving the conversation. Browse event and property definitions to understand your data model, search across all PostHog entities, and look up PostHog docs for instant context.\",\n        \"title\": \"PostHog\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.posthog.com/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"50688846-553c-4a12-bc21-df94d2173734\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"query-run\",\n            \"query-generate-hogql-from-question\",\n            \"insight-create-from-query\",\n            \"insight-get\",\n            \"insights-get-all\",\n            \"insight-update\",\n            \"insight-delete\",\n            \"insight-query\",\n            \"dashboard-create\",\n            \"dashboard-get\",\n            \"dashboards-get-all\",\n            \"dashboard-update\",\n            \"dashboard-delete\",\n            \"dashboard-reorder-tiles\",\n            \"add-insight-to-dashboard\",\n            \"create-feature-flag\",\n            \"feature-flag-get-definition\",\n            \"feature-flag-get-all\",\n            \"update-feature-flag\",\n            \"delete-feature-flag\",\n            \"experiment-create\",\n            \"experiment-get\",\n            \"experiment-get-all\",\n            \"experiment-results-get\",\n            \"experiment-update\",\n            \"experiment-delete\",\n            \"survey-create\",\n            \"survey-get\",\n            \"surveys-get-all\",\n            \"survey-update\",\n            \"survey-delete\",\n            \"survey-stats\",\n            \"surveys-global-stats\",\n            \"action-create\",\n            \"action-get\",\n            \"actions-get-all\",\n            \"action-update\",\n            \"action-delete\",\n            \"list-errors\",\n            \"error-details\",\n            \"logs-query\",\n            \"logs-list-attributes\",\n            \"logs-list-attribute-values\",\n            \"event-definitions-list\",\n            \"event-definition-update\",\n            \"properties-list\",\n            \"get-llm-total-costs-for-project\",\n            \"execute-sql\",\n            \"read-data-schema\",\n            \"read-data-warehouse-schema\",\n            \"organizations-get\",\n            \"organization-details-get\",\n            \"switch-organization\",\n            \"projects-get\",\n            \"switch-project\",\n            \"entity-search\",\n            \"docs-search\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"PostHog\",\n          \"oneLiner\": \"Query, analyze, and manage your PostHog insights\",\n          \"iconUrl\": \"https://posthog.com\",\n          \"documentation\": \"https://posthog.com/docs/model-context-protocol\",\n          \"support\": \"https://posthog.com/questions\",\n          \"privacyPolicy\": \"https://posthog.com/privacy\",\n          \"author\": {\n            \"name\": \"PostHog\",\n            \"url\": \"https://posthog.com\"\n          },\n          \"slug\": \"posthog\",\n          \"directoryUrl\": \"https://claude.ai/directory/50688846-553c-4a12-bc21-df94d2173734\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http posthog https://mcp.posthog.com/mcp\\n\",\n          \"worksWith\": [\n            \"claude\",\n            \"claude-code\"\n          ],\n          \"logo\": \"posthog\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"mcp.posthog.com/mcp\",\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-02-19\",\n          \"useCases\": [\n            \"code\"\n          ],\n          \"permissions\": \"Read and write\",\n          \"hasMcpApp\": true,\n          \"url\": \"https://mcp.posthog.com/mcp\",\n          \"rank\": 62,\n          \"popularityScore\": 14163,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 117464,\n          \"sortOrder\": 1\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"ai.vibeprospecting/vibeprospecting\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Turn your Claude agent into a prospecting platform. Find any company or professional right in your Claude. Get contact information, roles, tech stack, business events, website changes, Intent data, and much more. Build lead lists, research prospects, identify talent, and craft personalized outreach, all without leaving your chat. Vibe Prospecting delivers fresh B2B data backed by 50+ data sources. Vibe Prospecting has 150M+ companies and 800M+ professionals, with verified contact information, firmographics, technographics, hiring trends, intent signals, funding events, and more.\",\n        \"title\": \"Vibe Prospecting\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://vibeprospecting.explorium.ai/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"1bdcb159-b6f0-4f13-bc08-fdb40b007828\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"autocomplete\",\n            \"enrich-business\",\n            \"enrich-prospects\",\n            \"estimate-cost\",\n            \"export-to-csv\",\n            \"fetch-businesses-events\",\n            \"fetch-entities\",\n            \"fetch-entities-statistics\",\n            \"fetch-prospects-events\",\n            \"get-dataset\",\n            \"match-business\",\n            \"match-prospects\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"oneLiner\": \"Find company & contact data\",\n          \"iconUrl\": \"https://www.vibeprospecting.ai\",\n          \"documentation\": \"https://developers.explorium.ai/mcp-docs/agentsource-mcp\",\n          \"support\": \"https://www.vibeprospecting.ai/contact-us\",\n          \"privacyPolicy\": \"https://www.vibeprospecting.ai/privacy-policy\",\n          \"author\": {\n            \"name\": \"Vibeprospecting.ai\",\n            \"url\": \"https://www.vibeprospecting.ai\"\n          },\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-01-23\",\n          \"useCases\": [\n            \"sales-and-marketing\"\n          ],\n          \"rank\": 63,\n          \"popularityScore\": 14137,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 86754\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.daloopa.mcp/daloopa\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Daloopa supplies high quality fundamental data sourced from SEC Filings, investor presentations and any public financial documents, with hyperlinks to source document overlaying each data point. Provides a zero-hallucination foundation for any quantitative financial analysis in Claude.\",\n        \"title\": \"Daloopa\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.daloopa.com/server/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"67e0ebd7-f7c3-4917-b8f9-dc8c8cdcce13\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"discover_companies\",\n            \"discover_company_series\",\n            \"get_company_fundamentals\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Daloopa\",\n          \"oneLiner\": \"Financial fundamental data and KPIs with hyperlinks\",\n          \"iconUrl\": \"https://mcp.daloopa.com/server/mcp\",\n          \"documentation\": \"https://docs.daloopa.com/docs/daloopa-mcp#/\",\n          \"support\": \"mailto:mcp@daloopa.com\",\n          \"privacyPolicy\": \"https://docs.daloopa.com/docs/daloopa-privacy-and-data-collection-disclosure-for-mcp-access\",\n          \"url\": \"https://mcp.daloopa.com/server/mcp\",\n          \"author\": {\n            \"name\": \"Daloopa\",\n            \"url\": \"https://daloopa.com/\"\n          },\n          \"slug\": \"daloopa\",\n          \"directoryUrl\": \"https://claude.ai/directory/67e0ebd7-f7c3-4917-b8f9-dc8c8cdcce13\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http daloopa https://mcp.daloopa.com/server/mcp\",\n          \"permissions\": \"Read\",\n          \"useCases\": [\n            \"financial-services\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\"\n          ],\n          \"publishedOn\": \"Mon Jan 12 2026 16:21:41 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Thu Aug 28 2025 14:02:55 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Mon Jan 12 2026 16:20:13 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"daloopa\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"https://mcp.daloopa.com/server/mcp\",\n          \"itemId\": \"68b0618f2b7c3d073645ee15\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">Supplies high quality fundamental data sourced from SEC Filings, investor presentations and any public financial documents, with hyperlinks to source document overlaying each data point. Provides a zero-hallucination foundation for any quantitative financial analysis in Claude.<br><br>You can use the Daloopa connector to:<br><br>Build comparative dashboards:<br>\\\"Build a comparative dashboard for MSFT, ORCL, SAP, comparing cloud ARR growth, gross dollar retention and EBIT margin for the last 3 years. Break this out by quarters and show me both the data and growth rates calculated from the data. Use Daloopa data and provide hyperlinks\\\"</p><p id=\\\"\\\">Generate due diligence reports:<br>\\\"Generate a research report that summarizes all key historical trends for NVDIA, and specifically highlight changes in margins and pricing. Please break out which segments drove major changes for both. Use Daloopa data and provide hyperlinks\\\"</p><p id=\\\"\\\">Track inflection points:<br>\\\"For VRT, highlight key Q/Q changes from the most recent financial data compared to the previous quarter. Walk me through the main accels and decels and margin changes. Identify macroeconomic and company specific drivers of these trends. Use Daloopa data and provide hyperlinks\\\"</p><p id=\\\"\\\">Perform complex financial analysis:<br>\\\"Run me a sensitivity analysis on ARPU and impacts on fiscal year 26 profit margins for NFLX. Use only Non-GAAP data. Use Daloopa data and provide hyperlinks\\\"</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"rank\": 64,\n          \"popularityScore\": 14107,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 53838\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"ai.deepsense.mcp/chembl\",\n        \"version\": \"1.0.0\",\n        \"description\": \"The ChEMBL Connector gives Claude access to the ChEMBL Database, a manually curated resource of bioactive drug-like compounds with quantitative binding and functional data against biological targets.\",\n        \"title\": \"ChEMBL\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.deepsense.ai/chembl/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"711ccc94-754b-4659-903d-d61b29dd781e\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"get_admet\",\n            \"get_bioactivity\",\n            \"compound_search\",\n            \"drug_search\",\n            \"get_mechanism\",\n            \"target_search\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": true,\n          \"oneLiner\": \"Access the ChEMBL Database\",\n          \"iconUrl\": \"https://www.ebi.ac.uk/chembl/\",\n          \"documentation\": \"https://docs.mcp.deepsense.ai/guides/chembl.html\",\n          \"support\": \"mailto:mcp.support@deepsense.ai\",\n          \"privacyPolicy\": \"https://deepsense.ai/privacy-policy/\",\n          \"author\": {\n            \"name\": \"deepsense.ai\",\n            \"url\": \"https://deepsense.ai\"\n          },\n          \"slug\": \"chembl\",\n          \"permissions\": \"Read\",\n          \"useCases\": [\n            \"life-sciences\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-code\"\n          ],\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-01-07\",\n          \"rank\": 65,\n          \"popularityScore\": 14097,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 49312\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.kiwi.mcp/kiwi-com\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Brings flight search directly into Claude. The Kiwi connector supports one-way/round-trip, flexible dates, multiple passengers, all cabin classes. Works with Claude and Claude Desktop.\",\n        \"title\": \"Kiwi.com\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.kiwi.com\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"01c311c4-53cb-452a-90a8-1d524c9b97d6\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"search-flight\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": true,\n          \"displayName\": \"Kiwi.com\",\n          \"oneLiner\": \"Search flights in Claude\",\n          \"iconUrl\": \"https://kiwi.com/\",\n          \"documentation\": \"https://mcp-install-instructions.alpic.cloud/servers/kiwi-com-flight-search\",\n          \"support\": \"https://www.kiwi.com/us/help/contact/\",\n          \"privacyPolicy\": \"https://www.kiwi.com/en/pages/content/privacy/\",\n          \"url\": \"https://mcp.kiwi.com\",\n          \"author\": {\n            \"name\": \"Kiwi.com\",\n            \"url\": \"https://kiwi.com/\"\n          },\n          \"slug\": \"kiwi-com\",\n          \"directoryUrl\": \"https://claude.ai/directory/01c311c4-53cb-452a-90a8-1d524c9b97d6\",\n          \"permissions\": \"Read\",\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\"\n          ],\n          \"publishedOn\": \"Mon Jan 12 2026 16:21:41 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Mon Nov 24 2025 01:18:31 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Mon Jan 12 2026 16:20:14 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"kiwi-com\",\n          \"itemId\": \"6923b267f7fe20cf45558092\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">Brings flight search directly into Claude. The Kiwi connector supports one-way/round-trip, flexible dates, multiple passengers, all cabin classes. Works with Claude and Claude Desktop.<br><br>You can use the Kiwi connector to:</p><p id=\\\"\\\">Find Last-Minute Weekend Getaways:<strong id=\\\"\\\"><br>‍</strong>\\\"Find cheap flights this weekend from Vienna to somewhere warm, under €150\\\"</p><p id=\\\"\\\">Plan Family Trips with Specific Needs:<strong id=\\\"\\\"><br>‍</strong>\\\"Family of four, Barcelona to Rome, December 15-22, need morning departures due to traveling with young children\\\"</p><p id=\\\"\\\">Explore Budget Travel Destinations:<strong id=\\\"\\\"><br>‍</strong>\\\"Where can I fly from Amsterdam in March for under €100 round trip?\\\"</p><p id=\\\"\\\">Search Flexible Date Options:<strong id=\\\"\\\"><br>‍</strong>\\\"Show me the cheapest flights from London to Tokyo anytime in April\\\"</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"useCases\": [\n            \"productivity\"\n          ],\n          \"rank\": 66,\n          \"popularityScore\": 14051,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 59578\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"$schema\": \"https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json\",\n        \"name\": \"com.wix/mcp\",\n        \"description\": \"The Wix MCP provides users with the ability to manage their account's websites and apps (Stores, Bookings, Blog etc.). In addition, the MCP also helps devs create new sites using Wix Headless, the Wix Design system and more.\",\n        \"repository\": {\n          \"url\": \"https://github.com/wix/wix-mcp\",\n          \"source\": \"github\"\n        },\n        \"version\": \"1.0.2\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.wix.com/mcp\"\n          }\n        ],\n        \"title\": \"Wix\"\n      },\n      \"_meta\": {\n        \