  ],\n          \"logo\": \"postman\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"mcp.postman.com/minimal\",\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"useCases\": [\n            \"code\"\n          ],\n          \"permissions\": \"Read and write\",\n          \"added_at\": \"2026-03-06\",\n          \"rank\": 79,\n          \"popularityScore\": 13647,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 964289,\n          \"trending\": true,\n          \"sortOrder\": 1\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.consensus.app/consensus\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Consensus enables AI assistants to search through 200+ million peer-reviewed research papers from leading academic databases including Semantic Scholar, PubMed, and ArXiv. Users can find relevant scientific studies with advanced filtering by publication year, journal quality, sample size, and human subject studies. Each result includes comprehensive metadata: titles, abstracts, authors, citation counts, and direct links to papers. Perfect for researchers, students, healthcare professionals, and anyone seeking evidence-based answers backed by scientific literature.\",\n        \"title\": \"Consensus\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.consensus.app/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"65247229-f0c7-49df-9044-fcbb8b3894c6\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"search\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Consensus\",\n          \"oneLiner\": \"Explore scientific research\",\n          \"iconUrl\": \"https://consensus.app/\",\n          \"documentation\": \"https://docs.consensus.app/docs/mcp\",\n          \"support\": \"mailto:support@consensus.app\",\n          \"privacyPolicy\": \"https://consensus.app/home/privacy-policy/\",\n          \"url\": \"https://mcp.consensus.app/mcp\",\n          \"author\": {\n            \"name\": \"Consensus\",\n            \"url\": \"https://consensus.app/\"\n          },\n          \"slug\": \"consensus\",\n          \"directoryUrl\": \"https://claude.ai/directory/65247229-f0c7-49df-9044-fcbb8b3894c6\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http consensus https://mcp.consensus.app/mcp\\n\",\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"logo\": \"consensus\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"mcp.consensus.app/mcp\",\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"useCases\": [\n            \"data\"\n          ],\n          \"permissions\": \"Read Only\",\n          \"added_at\": \"2026-02-06\",\n          \"rank\": 80,\n          \"popularityScore\": 13499,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 74974\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.biorender.services.mcp/biorender\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Provides access to BioRender template and icon search for scientists.\",\n        \"title\": \"BioRender\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.services.biorender.com/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"81cc5080-a204-4aa1-a694-fa868a3c8720\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"search-icons\",\n            \"search-templates\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"BioRender\",\n          \"oneLiner\": \"Search for and use scientific templates and icons\",\n          \"iconUrl\": \"https://biorender.com\",\n          \"documentation\": \"https://help.biorender.com/hc/en-gb/articles/30870978672157-How-to-use-the-BioRender-MCP-connector\",\n          \"support\": \"mailto:support@biorender.com\",\n          \"privacyPolicy\": \"https://www.biorender.com/privacy\",\n          \"url\": \"https://mcp.services.biorender.com/mcp\",\n          \"author\": {\n            \"name\": \"BioRender\",\n            \"url\": \"https://biorender.com\"\n          },\n          \"slug\": \"biorender\",\n          \"directoryUrl\": \"https://claude.ai/directory/81cc5080-a204-4aa1-a694-fa868a3c8720\",\n          \"claudeCodeExternalLink\": \"https://support.claude.com/en/articles/12614768-getting-started-with-claude-for-life-sciences\",\n          \"permissions\": \"Read\",\n          \"useCases\": [\n            \"life-sciences\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"publishedOn\": \"Mon Jan 12 2026 16:21:41 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Fri Oct 17 2025 23:15:51 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Mon Jan 12 2026 16:20:14 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"biorender\",\n          \"backgroundPattern\": \"Loop 1\",\n          \"serverLabel\": \"mcp.services.biorender.com/mcp\",\n          \"itemId\": \"68f2ce27415acfa8bb74d838\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">Provides access to BioRender template and icon search for scientists.<br><br>You can use the BioRender connector to:<br><br>Create CRISPR mechanism graphics:<br>‍\\\"I need to create a graphical abstract showing how CRISPR-Cas9 gene editing works in plant cells for my NSF grant proposal. I want to show the Cas9 protein, guide RNA, DNA double-strand break, and then the DNA repair process. Can you find me templates for CRISPR mechanisms and plant cell structures?\\\"<br><br>Design cell therapy figures: <br>\\\"I'm working on a figure for a paper about CAR-T cell therapy targeting solid tumors. I need to illustrate: T cells being engineered with chimeric antigen receptors, the CAR-T cells trafficking through blood vessels to the tumor site, and then binding to tumor antigens. Can you help me find templates or icons that show T cell activation, tumor microenvironment, and cell-cell interactions?\\\"<br><br>Visual experimental workflows: <br>\\\"I'm presenting our latest RNA-seq results at an upcoming lab meeting and need to explain the experimental workflow to new graduate students. Can you find icons and templates showing: tissue sample collection, RNA extraction, library preparation, sequencing, and bioinformatics analysis pipeline?\\\"</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"rank\": 81,\n          \"popularityScore\": 13496,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 43631\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.mixpanel/mixpanel\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Query and analyze your Mixpanel data directly in Claude. Run segmentation, funnel, and retention analyses, explore your event taxonomy, manage Lexicon metadata, analyze session replays, and resolve data quality issues. With Mixpanel as persistent context, Claude can reason about your product data alongside your code, documents, and decisions, across any conversation.\",\n        \"title\": \"Mixpanel\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.mixpanel.com/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"29d60a67-6f16-489b-8a1e-efdcece8d1f6\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"Get-Projects\",\n            \"Get-Events\",\n            \"Get-Event-Details\",\n            \"Get-Property-Names\",\n            \"Get-Property-Values\",\n            \"Edit-Event\",\n            \"Edit-Property\",\n            \"Create-Tag\",\n            \"Rename-Tag\",\n            \"Delete-Tag\",\n            \"Dismiss-Issues\",\n            \"Get-Issues\",\n            \"Get-Lexicon-URL\",\n            \"Get-Query-Schema\",\n            \"Run-Query\",\n            \"Get-Report\",\n            \"List-Dashboards\",\n            \"Get-Dashboard\",\n            \"Create-Dashboard\",\n            \"Get-User-Replays-Data\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Mixpanel\",\n          \"oneLiner\": \"Analyze, query, and manage your Mixpanel data\",\n          \"iconUrl\": \"https://mixpanel.com/\",\n          \"documentation\": \"https://docs.mixpanel.com/docs/features/mcp\",\n          \"support\": \"https://mixpanel.com/contact-us/support/\",\n          \"privacyPolicy\": \"https://mixpanel.com/legal/privacy-policy/\",\n          \"url\": \"https://mcp.mixpanel.com/mcp\",\n          \"author\": {\n            \"name\": \"Mixpanel\",\n            \"url\": \"https://mixpanel.com/\"\n          },\n          \"slug\": \"mixpanel\",\n          \"directoryUrl\": \"https://claude.ai/directory/29d60a67-6f16-489b-8a1e-efdcece8d1f6\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http mixpanel https://mcp.mixpanel.com/mcp\\n\",\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"logo\": \"mixpanel\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"mcp.mixpanel.com/mcp\",\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"useCases\": [\n            \"data\"\n          ],\n          \"permissions\": \"Read and write\",\n          \"added_at\": \"2026-03-16\",\n          \"rank\": 82,\n          \"popularityScore\": 13491,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 107308\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.trivago.mcp/trivago\",\n        \"version\": \"1.0.0\",\n        \"description\": \"the trivago MCP server enables users to search for hotels and other accommodations using coordinates or broader geographic areas such as cities and countries. It provides tailored search results based on location and date inputs, helping users find suitable places to stay near specific points of interest or within larger regions. The server returns a list of hotels with prices from different providers, photos, accommodation details, and links to the accommodation details page.\",\n        \"title\": \"Trivago\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.trivago.com/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"81cc5080-a204-4aa1-a694-fa868a3c8718\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"trivago-accommodation-radius-search\",\n            \"trivago-accommodation-search\",\n            \"trivago-search-suggestions\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": true,\n          \"displayName\": \"Trivago\",\n          \"oneLiner\": \"Find your ideal hotel at the best price.\",\n          \"iconUrl\": \"https://www.trivago.com\",\n          \"documentation\": \"https://mcp.trivago.com/docs\",\n          \"support\": \"mailto:mcp.support@trivago.com\",\n          \"privacyPolicy\": \"https://www.trivago.com/en-US/sp/privacy-policy\",\n          \"url\": \"https://mcp.trivago.com/mcp\",\n          \"author\": {\n            \"name\": \"trivago\",\n            \"url\": \"https://www.trivago.com\"\n          },\n          \"slug\": \"trivago\",\n          \"directoryUrl\": \"https://claude.ai/directory/81cc5080-a204-4aa1-a694-fa868a3c8718\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http trivago https://mcp.trivago.com/mcp\",\n          \"permissions\": \"Read\",\n          \"worksWith\": [\n            \"claude\",\n            \"claude-code\"\n          ],\n          \"publishedOn\": \"Mon Jan 12 2026 16:21:41 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Fri Oct 24 2025 00:04:42 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Mon Jan 12 2026 16:20:15 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"trivago-2\",\n          \"serverLabel\": \"mcp.trivago.com/mcp\",\n          \"itemId\": \"68fac29a7cf665291038c761\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">The Trivago connector enables users to search for hotels and accommodations using coordinates or broader geographic areas such as cities and countries. It provides tailored search results based on location and date inputs, helping users find suitable places to stay near specific points of interest or within larger regions.<br><br>You can use the Trivago connector to:&nbsp;<br><br>Search hotels by destination and dates: <br>\\\"Find me a hotel in Las Vegas for 2 people from 12 July to 20 July 2026\\\"</p><p id=\\\"\\\">Find budget accommodation near landmarks: <br>\\\"I need a cheap accommodation near the Eiffel Tower for 1 night the 12th of June 2026\\\"</p><p id=\\\"\\\">Book hotels near event venues: <br>\\\"Find me a hotel near the Etihad Stadium for 12 July to 14 July 2026\\\"</p><p id=\\\"\\\">Coordinate travel with conferences: <br>\\\"I need accommodation close to the venue of the next KubeCon happening in Europe in 2026\\\"</p><p id=\\\"\\\">Plan family vacations: <br>\\\"I am searching for 2 rooms for 2 adults and 2 children aged 6 and 10 in Barcelona for Easter 2026\\\"</p><p id=\\\"\\\">‍</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"useCases\": [\n            \"productivity\"\n          ],\n          \"rank\": 83,\n          \"popularityScore\": 13418,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 56138\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.attio/attio\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Access your entire CRM directly from Claude. Look up contacts and companies, find decision makers, and discover email addresses. Log notes from calls and meetings, track engagement history, and create follow-up tasks with deadlines. Search and filter your pipeline by stage, funding round, role, or location. Tap into meeting intelligence—search call recordings, access transcripts, and surface key insights. Make Attio a seamless part of your AI workflow, so you can manage relationships and close deals faster without switching tools.\",\n        \"title\": \"Attio\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.attio.com/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"ae5afdb9-e3c6-4b64-a13a-420e7a8d8124\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"create-note\",\n            \"create-record\",\n            \"create-task\",\n            \"get-call-recording\",\n            \"get-email-content\",\n            \"get-note-body\",\n            \"get-records-by-ids\",\n            \"list-attribute-definitions\",\n            \"list-records\",\n            \"list-workspace-members\",\n            \"list-workspace-teams\",\n            \"search-call-recordings-by-metadata\",\n            \"search-emails-by-metadata\",\n            \"search-meetings\",\n            \"search-notes-by-metadata\",\n            \"search-records\",\n            \"semantic-search-emails\",\n            \"semantic-search-notes\",\n            \"update-task\",\n            \"update-record\",\n            \"upsert-record\",\n            \"whoami\",\n            \"list-tasks\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Attio\",\n          \"oneLiner\": \"Search, manage, and update your Attio CRM from Claude\",\n          \"iconUrl\": \"https://attio.com\",\n          \"documentation\": \"https://docs.attio.com/mcp/overview\",\n          \"support\": \"mailto:support@attio.com\",\n          \"privacyPolicy\": \"https://attio.com/legal/privacy\",\n          \"url\": \"https://mcp.attio.com/mcp\",\n          \"author\": {\n            \"name\": \"Attio\",\n            \"url\": \"https://attio.com\"\n          },\n          \"slug\": \"attio\",\n          \"directoryUrl\": \"https://claude.ai/directory/ae5afdb9-e3c6-4b64-a13a-420e7a8d8124\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http attio https://mcp.attio.com/mcp\\n\",\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"logo\": \"attio\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"mcp.attio.com/mcp\",\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"useCases\": [\n            \"productivity\"\n          ],\n          \"permissions\": \"Read and write\",\n          \"added_at\": \"2026-02-12\",\n          \"rank\": 84,\n          \"popularityScore\": 13403,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 58790\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"io.modelcontextprotocol/server-threejs\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Demo interactive 3D viewer powered by Three.js, a popular JavaScript library for rendering 3D graphics in the browser. Generates and displays 3D scenes, models, and animations directly in the conversation.\",\n        \"title\": \"Three.js 3D Viewer\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://example-server.modelcontextprotocol.io/threejs/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"471ca2be-244d-4d9a-955a-3cdbcf76a12b\",\n          \"type\": \"remote\",\n          \"toolNames\": [],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Three.js 3D Viewer\",\n          \"oneLiner\": \"Demo 3D viewer that renders interactive 3D scenes and models using Three.js\",\n          \"iconUrl\": \"https://raw.githubusercontent.com/modelcontextprotocol/modelcontextprotocol/refs/heads/main/blog/static/favicon.svg\",\n          \"documentation\": \"https://github.com/modelcontextprotocol/ext-apps/blob/main/examples/pdf-server/README.md\",\n          \"support\": \"https://github.com/modelcontextprotocol/ext-apps/issues\",\n          \"privacyPolicy\": \"https://lfprojects.org/policies/privacy-policy/\",\n          \"url\": \"https://example-server.modelcontextprotocol.io/threejs/mcp\",\n          \"author\": {\n            \"name\": \"Model Context Protocol Community\",\n            \"url\": \"https://modelcontextprotocol.io\"\n          },\n          \"slug\": \"threejs-3d-viewer\",\n          \"directoryUrl\": \"https://claude.ai/directory/471ca2be-244d-4d9a-955a-3cdbcf76a12b\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http threejs-3d-viewer https://example-server.modelcontextprotocol.io/threejs/mcp\\n\",\n          \"worksWith\": [\n            \"claude\"\n          ],\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-01-25\",\n          \"useCases\": [\n            \"code\"\n          ],\n          \"rank\": 85,\n          \"popularityScore\": 13322,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 65361\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"$schema\": \"https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json\",\n        \"name\": \"com.getguru/mcp-server\",\n        \"description\": \"Guru's MCP Server connects Anthropic's Claude to your company's trusted knowledge layer, so every AI answer is grounded in verified, permission-aware information—not outdated docs or hallucinations. It links Claude to the same governed context your teams use, ensuring consistent, cited, and explainable responses. With built-in verification and lineage, the Guru MCP Server makes it easy for Claude to deliver answers you can trust across every workflow.\",\n        \"title\": \"Guru\",\n        \"repository\": {\n          \"url\": \"https://github.com/guruhq/remote-mcp-server\",\n          \"source\": \"github\"\n        },\n        \"version\": \"1.0.2\",\n        \"websiteUrl\": \"https://developer.getguru.com/docs/guru-mcp-server-overview\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.api.getguru.com/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"publishedAt\": \"2026-01-13T15:14:01.877837Z\",\n          \"updatedAt\": \"2026-01-13T15:14:01.877837Z\",\n          \"isLatest\": true\n        },\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"6d13e7f5-f465-498c-b7c9-b99c4bc74719\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"answer_generation\",\n            \"create_draft\",\n            \"search_documents\",\n            \"update_card\",\n            \"list_knowledge_agents\",\n            \"get_card_by_id\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Guru\",\n          \"oneLiner\": \"Search and interact with your company knowledge\",\n          \"iconUrl\": \"https://www.getguru.com\",\n          \"documentation\": \"https://help.getguru.com/docs/connecting-gurus-mcp-server\",\n          \"support\": \"mailto:support@getguru.com\",\n          \"privacyPolicy\": \"https://www.getguru.com/privacy\",\n          \"url\": \"https://mcp.api.getguru.com/mcp\",\n          \"author\": {\n            \"name\": \"Guru\",\n            \"url\": \"https://www.getguru.com\"\n          },\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-01-19\",\n          \"useCases\": [\n            \"productivity\"\n          ],\n          \"rank\": 86,\n          \"popularityScore\": 13243,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 43019\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.moodys.api/moody-s\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Moody's GenAI-Ready Data powers AI applications with access to Moody's Ratings proprietary credit ratings, research, and comprehensive entity intelligence. Get streamlined access to high-quality data such as ownership structures, financials, ratings drivers, and scorecards, all structured to optimize a variety of workflows including compliance, credit analysis, M&A, and business development.\",\n        \"title\": \"Moody's\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://api.moodys.com/genai-ready-data/m1/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"83a7523b-d6c5-45f8-89de-90a2998bae49\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"findEntity\",\n            \"getEntityPeers\",\n            \"getEntityCreditOpinionSummary\",\n            \"getEntityCreditUpgradeDowngradeFactors\",\n            \"getEntitySectorOutlook\",\n            \"searchAllDocuments\",\n            \"getEntityCountryProfile\",\n            \"searchEntityEarningsCall\",\n            \"getEntityRatings\",\n            \"searchEntityDocuments\",\n            \"getEntityCreditOpinionOutlook\",\n            \"getEntitySwot\",\n            \"getEntityEsg\",\n            \"getEntityScorecard\",\n            \"searchNews\",\n            \"\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Moody's\",\n          \"oneLiner\": \"Risk insights, analytics, and decision intelligence\",\n          \"iconUrl\": \"https://moodys.com\",\n          \"documentation\": \"https://www.moodys.com/web/en/us/genai/model-context-protocol.html\",\n          \"support\": \"mailto:clientservices@moodys.com\",\n          \"privacyPolicy\": \"https://www.moodys.com/web/en/us/legal/privacy-policy.html\",\n          \"url\": \"https://api.moodys.com/genai-ready-data/m1/mcp\",\n          \"author\": {\n            \"name\": \"Moody's Analytics\",\n            \"url\": \"https://moodys.com\"\n          },\n          \"slug\": \"moodys-analytics\",\n          \"directoryUrl\": \"https://claude.ai/directory/83a7523b-d6c5-45f8-89de-90a2998bae49\",\n          \"permissions\": \"Read\",\n          \"useCases\": [\n            \"financial-services\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\"\n          ],\n          \"publishedOn\": \"Mon Jan 12 2026 16:21:41 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Fri Oct 24 2025 19:49:45 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Mon Jan 12 2026 16:20:16 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"moodys\",\n          \"serverLabel\": \"api.moodys.com/genai-ready-data/m1/mcp\",\n          \"itemId\": \"68fbd8599adacd33c5049997\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">Get streamlined access to Moody's Ratings proprietary credit ratings, research, and comprehensive entity intelligence. Access high-quality data such as ownership structures, financials, ratings drivers, and scorecards, all structured to optimize a variety of workflows including compliance, credit analysis, M&amp;A, and business development.</p><p id=\\\"\\\">You can use the Moody's Analytics connector to:<br><br>Review historical ratings:<br>\\\"For Ford give ratings for the last 5 years\\\"</p><p id=\\\"\\\">Compare company scorecards:<br>\\\"Find Ford and Tesla companies and get their scorecards and compare them\\\"</p><p id=\\\"\\\">Analyze rating drivers:<br>\\\"Find 3 largest investment grade US tech companies and give me their rating drivers\\\"</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-14\",\n          \"rank\": 87,\n          \"popularityScore\": 13197,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 49475\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"dev.jam.mcp/jam\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Jam's MCP is the fast lane between Jam recordings and your dev tools. Drop a Jam link into VS Code, Cursor, Windsurf, or Claude and the whole recording – video, console, network, logs – arrives pre-packaged. No hand-typing repro steps, no copy-paste stack traces, no screen-share drama. Your tools get instant context, you stay in flow.\",\n        \"title\": \"Jam\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.jam.dev/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"923fb14b-ed65-4e41-8dd5-4c2c38c00457\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"getDetails\",\n            \"getConsoleLogs\",\n            \"getNetworkRequests\",\n            \"getScreenshot\",\n            \"getUserEvents\",\n            \"analyzeVideo\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Jam\",\n          \"oneLiner\": \"Record screen and collect automatic context for issues\",\n          \"iconUrl\": \"https://mcp.jam.dev/mcp\",\n          \"documentation\": \"https://jam.dev/docs/debug-a-jam/mcp\",\n          \"support\": \"mailto:hello@jam.dev\",\n          \"privacyPolicy\": \"https://jam.dev/privacy\",\n          \"url\": \"https://mcp.jam.dev/mcp\",\n          \"author\": {\n            \"name\": \"Jam\",\n            \"url\": \"https://jam.dev/\"\n          },\n          \"slug\": \"jam\",\n          \"directoryUrl\": \"https://claude.ai/directory/923fb14b-ed65-4e41-8dd5-4c2c38c00457\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http jam https://mcp.jam.dev/mcp\\n\",\n          \"permissions\": \"Read\",\n          \"useCases\": [\n            \"code\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"publishedOn\": \"Mon Jan 12 2026 16:21:41 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Thu Aug 28 2025 14:02:56 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Mon Jan 12 2026 16:20:15 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"jam\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"mcp.jam.dev/mcp\",\n          \"itemId\": \"68b0619097a6a7e363bef1e0\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">The fast lane between Jam recordings and your dev tools. Drop a Jam link into Claude and the whole recording – video, console, network, logs – arrives pre-packaged. No hand-typing repro steps, no copy-paste stack traces, no screen-share drama. Claude gets instant context, you stay in flow.</p><p id=\\\"\\\">You can use the Jam connector to:<br><br>Analyze bugs and create implementation plans:<br>\\\"Review this Jam &lt;Jam Link&gt; and analyze the problem, cross-reference it with the existing codebase, and prepare a detailed plan for implementation\\\"</p><p id=\\\"\\\">Perform root-cause analysis and organize work:<br>\\\"Analyze these Jams, perform root-cause analysis, and organize them into efficient work packages to minimize engineers' context switching; create Linear tickets from the analysis. &lt;Jam Link&gt;\\\"</p><p id=\\\"\\\">Turn product feedback into action plans:<br>\\\"I recorded product feedback in a Jam. Create an implementation plan for the changes requested in this Jam: &lt;Jam Link&gt;\\\"</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"rank\": 88,\n          \"popularityScore\": 13081,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 44119\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"org.synapse.mcp/synapse-org\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Discover and explore scientific datasets from collaborative research projects. Search Synapse for genomics, imaging, clinical data on cancer, neurodegenerative diseases, rare diseases, and more. Navigate project hierarchies and get detailed metadata and provenance to understand what datasets contain before you download.\\n\\nWhen using an MCP server with Claude, please review Anthropic's data handling policies to understand how your data is processed:\\n• [Consumer accounts](https://privacy.claude.com/en/collections/10672565-data-handling-retention)\\n• [Commercial accounts](https://privacy.claude.com/en/collections/10672411-data-handling-retention)\\n\\nYou remain responsible for compliance with any data use restrictions and Synapse [Terms of Service](https://www.synapse.org/TrustCenter:TermsOfService)\",\n        \"title\": \"Synapse.org\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.synapse.org/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"81cc5080-a204-4aa1-a694-fa868a3c8719\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"get_entity\",\n            \"get_entity_annotations\",\n            \"get_entity_provenance\",\n            \"get_entity_children\",\n            \"search_synapse\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Synapse.org\",\n          \"oneLiner\": \"Search and metadata tools for Synapse scientific data\",\n          \"iconUrl\": \"https://sagebionetworks.org/\",\n          \"documentation\": \"https://github.com/susheel/synapse-mcp?tab=readme-ov-file#synapse-mcp-server\",\n          \"support\": \"https://github.com/susheel/synapse-mcp/issues\",\n          \"privacyPolicy\": \"https://s3.amazonaws.com/static.synapse.org/governance/SynapsePrivacyPolicy.pdf?v=5\",\n          \"url\": \"https://mcp.synapse.org/mcp\",\n          \"author\": {\n            \"name\": \"Sage Bionetworks\",\n            \"url\": \"https://sagebionetworks.org/\"\n          },\n          \"slug\": \"synapse-org\",\n          \"directoryUrl\": \"https://claude.ai/directory/81cc5080-a204-4aa1-a694-fa868a3c8719\",\n          \"claudeCodeExternalLink\": \"https://support.claude.com/en/articles/12614798-using-the-synapse-org-connector-in-claude\",\n          \"permissions\": \"Read\",\n          \"useCases\": [\n            \"life-sciences\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"publishedOn\": \"Mon Jan 12 2026 16:21:41 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Fri Oct 17 2025 23:13:11 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Mon Jan 12 2026 16:20:15 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"synapse\",\n          \"backgroundPattern\": \"Loop 3\",\n          \"serverLabel\": \"mcp.synapse.org/mcp\",\n          \"itemId\": \"68f2cd8765beadf8905381b3\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">Discover and explore scientific datasets from collaborative research projects. Search Synapse for genomics, imaging, clinical data on cancer, neurodegenerative diseases, rare diseases, and more. Navigate project hierarchies and get detailed metadata and provenance to understand what datasets contain before you download.<br><br>You can use the Synapse.org connector to:<br><br>Search for datasets and projects:<br>\\\"Search Synapse for genomics datasets related to Alzheimer's disease\\\"</p><p id=\\\"\\\">Retrieve entity metadata:<br>\\\"Get the metadata and provenance information for project syn12345678\\\"</p><p id=\\\"\\\">Traverse project hierarchies:<br>\\\"Show me all the folders and files within the Cancer Research project\\\"</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"rank\": 89,\n          \"popularityScore\": 12995,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 41235\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.udemy.api/udemy-business\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Udemy Business MCP brings our comprehensive AI-powered skills development platform directly into your AI tools. Employees discover and access expertly curated courses via personalized search and recommendations. This enables just-in-time learning in the flow of work with enterprise-grade security and scalability.\",\n        \"title\": \"Udemy Business\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://api.udemy.com/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"d4ba36c1-89dd-49ee-aea3-2317efccc424\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"search_courses\",\n            \"search_learning_paths\",\n            \"search_lectures\",\n            \"search_labs\",\n            \"get_course_curriculum\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Udemy Business\",\n          \"oneLiner\": \"Search and explore skill-building resources\",\n          \"iconUrl\": \"https://www.udemy.com\",\n          \"documentation\": \"https://business-support.udemy.com/hc/en-us/articles/34213384429335-How-to-Integrate-the-Udemy-Business-MCP-Server-With-Your-AI-Tool#h_01K9CA42YGCV1AVXPY1RKABKP1\",\n          \"support\": \"https://support.udemy.com/\",\n          \"privacyPolicy\": \"https://www.udemy.com/terms/privacy/\",\n          \"url\": \"https://api.udemy.com/mcp\",\n          \"author\": {\n            \"name\": \"Udemy, Inc.\",\n            \"url\": \"https://www.udemy.com\"\n          },\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-01-12\",\n          \"useCases\": [\n            \"productivity\"\n          ],\n          \"rank\": 90,\n          \"popularityScore\": 12992,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 91112\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"app.fellow/fellow-ai\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Access your meeting knowledge instantly. Fellow connects Claude to your meeting ecosystem, letting you search transcripts, pull key insights from summaries, and track action items with natural-language queries.\",\n        \"title\": \"Fellow.ai\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://fellow.app/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"069b18da-5c89-4a66-941f-0cb6eae49a8d\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"get_action_items\",\n            \"get_meeting_participants\",\n            \"get_meeting_summary\",\n            \"get_meeting_transcript\",\n            \"search_meetings\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Fellow.ai\",\n          \"oneLiner\": \"Chat with your meetings to uncover actionable insights\",\n          \"iconUrl\": \"https://fellow.ai/\",\n          \"documentation\": \"https://help.fellow.ai/en/articles/12622641-fellow-s-mcp-server\",\n          \"support\": \"https://help.fellow.ai/\",\n          \"privacyPolicy\": \"https://fellow.ai/privacy-policy\",\n          \"url\": \"https://fellow.app/mcp\",\n          \"author\": {\n            \"name\": \"Fellow.ai\",\n            \"url\": \"https://fellow.ai/\"\n          },\n          \"slug\": \"fellow-ai\",\n          \"directoryUrl\": \"https://claude.ai/directory/069b18da-5c89-4a66-941f-0cb6eae49a8d\",\n          \"permissions\": \"Read\",\n          \"useCases\": [\n            \"communication\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\"\n          ],\n          \"publishedOn\": \"Mon Jan 12 2026 16:21:41 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Fri Nov 14 2025 21:49:47 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Mon Jan 12 2026 16:20:16 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"fellow-ai\",\n          \"itemId\": \"6917a3fbd95a5f390d31ec62\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">Access your meeting knowledge instantly. Fellow connects Claude to your meeting ecosystem, letting you search transcripts, pull key insights from summaries, and track action items with natural-language queries. Need to recall decisions from last quarter? Looking for action items assigned to your team? Want to reference that brilliant idea from yesterday's brainstorm? Simply ask Claude and skip the endless scrolling through notes. Get the clarity you need, exactly when you need it, with Fellow's secure, centralized meeting intelligence.<br><br>You can use the Fellow.ai connector to:&nbsp;<br><br>Search Past Meeting Discussions:<strong id=\\\"\\\"><br>‍</strong>\\\"In yesterday's client call with Acme Corp, what concerns did they raise about our implementation timeline?\\\"</p><p id=\\\"\\\">Find Decisions &amp; Budget Allocations:<strong id=\\\"\\\"><br>‍</strong>\\\"Find the discussion about our Q3 marketing budget from last week's strategy meeting. What was the final decision on the social media campaign allocation?\\\"</p><p id=\\\"\\\">Summarize Multiple Meetings:<strong id=\\\"\\\"><br>‍</strong>\\\"Show me the most important decisions and action items from the last three weekly engineering stand-ups so I can prepare for tomorrow's meeting\\\"</p><p id=\\\"\\\">Get Performance Coaching:<strong id=\\\"\\\"><br>‍</strong>\\\"Please coach me on how I can improve my sales approach, based on how yesterday's customer calls went\\\"</p><p id=\\\"\\\">Track Personal Action Items:<strong id=\\\"\\\"><br>‍</strong>\\\"What action items were I assigned this week in my meetings with John?\\\"</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-26\",\n          \"rank\": 91,\n          \"popularityScore\": 12968,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 45644\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.crossbeam.mcp/crossbeam\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Connect your Claude workspace to Crossbeam and bring Ecosystem Intelligence into every AI workflow. The Crossbeam MCP Server lets Claude securely access your partner and account data — surfacing overlaps, partner activity, and warm paths directly in chat. Use it to enrich AI responses with real-time ecosystem context, power smarter prioritization, and uncover co-sell opportunities without leaving your conversation.\",\n        \"title\": \"Crossbeam\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.crossbeam.com\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"42ce667a-962d-432c-b667-35f0266ac6b5\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"find_partners\",\n            \"get_partner_tags\",\n            \"get_partner_suggestions\",\n            \"get_partner_leaderboard\",\n            \"get_own_populations\",\n            \"get_partner_populations\",\n            \"get_account_overlap_info\",\n            \"get_own_account_info\",\n            \"get_record_signals\",\n            \"search_help_center\",\n            \"search_blog_site\",\n            \"search_elg_book\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Crossbeam\",\n          \"oneLiner\": \"Explore partner data and ecosystem insights in Claude\",\n          \"iconUrl\": \"https://crossbeam.com\",\n          \"documentation\": \"https://help.crossbeam.com/en/articles/12601327-crossbeam-mcp-server-beta\",\n          \"support\": \"mailto:support@crossbeam.com\",\n          \"privacyPolicy\": \"https://www.crossbeam.com/legal/crossbeam-privacy-policy\",\n          \"url\": \"https://mcp.crossbeam.com\",\n          \"author\": {\n            \"name\": \"Crossbeam\",\n            \"url\": \"https://crossbeam.com\"\n          },\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"useCases\": [\n            \"productivity\",\n            \"communication\"\n          ],\n          \"rank\": 92,\n          \"popularityScore\": 12929,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 49904\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"io.outreach/mcp\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Bring Outreach knowledge and actions into Claude so your teams can move faster, combine insights across systems, and complete advanced revenue tasks without switching tools. Outreach is an end-to-end AI Revenue Platform for all go-to-market teams. By embedding agentic AI across every revenue workflow, Outreach increases sales productivity, boosts pipeline, and gives leaders the visibility and predictability they need to grow revenue at scale.\",\n        \"title\": \"Outreach\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://api.outreach.io/mcp/\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"7b2bdb34-e318-4d50-893f-330a8e41d78c\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"fetch_kaia_meetings\",\n            \"emails_search\",\n            \"sequence_search_by_name\",\n            \"prospect_get_by_id\",\n            \"prospect_search_by_name\",\n            \"prospect_search_by_ext_id\",\n            \"account_get_by_id\",\n            \"account_search_by_name\",\n            \"account_search_by_ext_id\",\n            \"opportunity_get_by_id\",\n            \"opportunity_search_by_name\",\n            \"opportunity_search_by_ext_id\",\n            \"user_get_by_id\",\n            \"user_search_by_nam\",\n            \"user_search_by_ext_id\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Outreach\",\n          \"oneLiner\": \"Unleash your team's best performance with Outreach AI\",\n          \"iconUrl\": \"https://outreach.io\",\n          \"documentation\": \"https://support.outreach.io/hc/en-us/articles/46370115253403-Outreach-MCP-Server\",\n          \"support\": \"https://support.outreach.io/\",\n          \"privacyPolicy\": \"https://www.outreach.io/privacy-statement\",\n          \"url\": \"https://api.outreach.io/mcp/\",\n          \"author\": {\n            \"name\": \"Outreach\",\n            \"url\": \"https://outreach.io\"\n          },\n          \"slug\": \"outreach\",\n          \"directoryUrl\": \"https://claude.ai/directory/7b2bdb34-e318-4d50-893f-330a8e41d78c\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http outreach https://api.outreach.io/mcp/\\n\",\n          \"worksWith\": [\n            \"claude\",\n            \"claude-code\"\n          ],\n          \"logo\": \"outreach\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"api.outreach.io/mcp\",\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"useCases\": [\n            \"sales-and-marketing\"\n          ],\n          \"permissions\": \"Read Only\",\n          \"added_at\": \"2026-02-18\",\n          \"rank\": 93,\n          \"popularityScore\": 12926,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 72926\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.lastminute.mcp/lastminute-com\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Access real-time flight and hotel data directly through Claude to search, compare, and book flights, dynamic packages (flight + hotel), and hotels across a global network of airlines and hotel suppliers. Benefit from instant price comparisons, flexible filters, and intelligent recommendations that seamlessly integrate Claude's capabilities into your travel planning. Enhance your workflow with comprehensive flight, dynamic package, and hotel search powered by lastminute.com.\",\n        \"title\": \"lastminute.com\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.lastminute.com/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"3ae97a2c-ee7f-4dba-8e0c-23662d036124\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"search_flights\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": true,\n          \"displayName\": \"lastminute.com\",\n          \"oneLiner\": \"Search, compare and book flights, dynamic packages (flight + hotel) and hotels across global airlines and hotel suppliers.\",\n          \"iconUrl\": \"https://www.lastminute.com/\",\n          \"documentation\": \"https://mcp.lastminute.com/docs\",\n          \"support\": \"mailto:mcp@lastminute.com\",\n          \"privacyPolicy\": \"https://www.lastminute.com/en/info/privacy/bravonext.html\",\n          \"url\": \"https://mcp.lastminute.com/mcp\",\n          \"author\": {\n            \"name\": \"lastminute.com\",\n            \"url\": \"https://www.lastminute.com/\"\n          },\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-01-12\",\n          \"useCases\": [\n            \"productivity\"\n          ],\n          \"rank\": 94,\n          \"popularityScore\": 12912,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 61949\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.bitly.api-ssl/bitly\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Create, track, and manage Bitly links and QR Codes directly from Claude without switching contexts. Access 27 comprehensive tools spanning link creation, analytics, organizational management, and more—making this the most complete link management solution available in any AI assistant.\",\n        \"title\": \"Bitly\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://api-ssl.bitly.com/v4/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"b8f1c2a3-9d4e-5f6g-7h8i-9j0k1l2m3n4o\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"create_short_link\",\n            \"get_short_link_details\",\n            \"update_short_link\",\n            \"delete_short_link\",\n            \"expand\",\n            \"custom_backhalf\",\n            \"link_metrics\",\n            \"link_clicks_summary\",\n            \"link_countries\",\n            \"link_cities\",\n            \"link_devices\",\n            \"link_referrers\",\n            \"link_referring_domains\",\n            \"create_qr_code\",\n            \"get_qr_code\",\n            \"get_qr_code_image\",\n            \"update_qr_code\",\n            \"get_group_qr_codes\",\n            \"get_user\",\n            \"get_organizations\",\n            \"get_groups\",\n            \"get_group_details\",\n            \"get_group_short_links\",\n            \"get_group_short_links_sorted\",\n            \"get_custom_domains\",\n            \"get_custom_link_details\",\n            \"update_destination\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Bitly\",\n          \"oneLiner\": \"Shorten links, generate QR Codes, and track performance\",\n          \"iconUrl\": \"https://bitly.com\",\n          \"documentation\": \"https://dev.bitly.com/bitly-mcp/\",\n          \"support\": \"https://support.bitly.com/hc/en-us\",\n          \"privacyPolicy\": \"https://bitly.com/pages/privacy\",\n          \"url\": \"https://api-ssl.bitly.com/v4/mcp\",\n          \"author\": {\n            \"name\": \"Bitly\",\n            \"url\": \"https://bitly.com\"\n          },\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-01-08\",\n          \"useCases\": [\n            \"data\"\n          ],\n          \"rank\": 96,\n          \"popularityScore\": 12842,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 57819\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.cdata.cloud.mcp/cdata-connect-ai\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Connect Claude to read, write, and act on 350+ enterprise data sources like Salesforce, Snowflake and NetSuite in real-time through one fully hosted remote MCP server. Connect AI is the only managed MCP platform built with semantic intelligence that understands your data's metadata and relationships across systems for multi-source analysis. Ensure trusted boundaries with enterprise security, granular permissions, and complete audit trails. Set up any source in minutes and get started free.\",\n        \"title\": \"CData Connect AI\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.cloud.cdata.com/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"9df925ce-a2fc-42f1-93dd-748516052caf\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"getTables\",\n            \"getSchemas\",\n            \"getProcedures\",\n            \"getProcedureParameters\",\n            \"getPrimaryKeys\",\n            \"getIndexes\",\n            \"getImportedKeys\",\n            \"getExportedKeys\",\n            \"getColumns\",\n            \"getCatalogs\",\n            \"execData\",\n            \"queryData\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"CData Connect AI\",\n          \"oneLiner\": \"Managed MCP platform for 350 sources\",\n          \"iconUrl\": \"https://www.cdata.com/cloud/ai/\",\n          \"documentation\": \"https://cloud.cdata.com/docs/Claude-Client.html\",\n          \"support\": \"https://portal.cdata.com/?a=support\",\n          \"privacyPolicy\": \"https://www.cdata.com/company/legal/privacy/\",\n          \"url\": \"https://mcp.cloud.cdata.com/mcp\",\n          \"author\": {\n            \"name\": \"CData\",\n            \"url\": \"https://www.cdata.com/ai\"\n          },\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-26\",\n          \"useCases\": [\n            \"data\"\n          ],\n          \"rank\": 97,\n          \"popularityScore\": 12684,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 48737\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"ai.circleback.app/circleback\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Bring context from Circleback into Claude. Search and access meeting notes, transcripts, calendar events, emails, people, companies, and more.\",\n        \"title\": \"Circleback\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://app.circleback.ai/api/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"91c3f3e4-8c61-4f73-b912-96d035f69f24\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"SearchMeetings\",\n            \"SearchTranscripts\",\n            \"GetTranscriptsForMeetings\",\n            \"ReadMeetings\",\n            \"FindProfiles\",\n            \"FindDomains\",\n            \"SearchCalendarEvents\",\n            \"SearchEmails\",\n            \"SearchSupportArticles\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Circleback\",\n          \"oneLiner\": \"Search and access context from meetings\",\n          \"iconUrl\": \"https://circleback.ai\",\n          \"documentation\": \"https://circleback.ai/docs/mcp\",\n          \"support\": \"https://support.circleback.ai\",\n          \"privacyPolicy\": \"https://circleback.ai/privacy\",\n          \"url\": \"https://app.circleback.ai/api/mcp\",\n          \"author\": {\n            \"name\": \"Circleback\",\n            \"url\": \"https://circleback.ai\"\n          },\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"useCases\": [\n            \"communication\",\n            \"productivity\"\n          ],\n          \"added_at\": \"2026-01-12\",\n          \"rank\": 98,\n          \"popularityScore\": 12669,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 45356\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.blueskyapi.vast-mcp/mt-newswires\",\n        \"version\": \"1.0.0\",\n        \"description\": \"MT Newswires' MCP server delivers real-time, low-latency financial news across equities, fixed income, commodities, FX, and macroeconomics. Structured and machine-readable, it integrates seamlessly into AI, trading, and analytics systems, providing scalable, reliable, event-driven intelligence from MT Newswires' global newsroom trusted by leading banks, brokerages, and data providers.\",\n        \"title\": \"MT Newswires\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://vast-mcp.blueskyapi.com/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"441c79ad-8a68-4d73-9263-7cfcadd5d8cf\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"current_date\",\n            \"search\",\n            \"fetch\",\n            \"create_rule\",\n            \"create_rules\",\n            \"delete_rule\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"MT Newswires\",\n          \"oneLiner\": \"Trusted real-time global financial news provider\",\n          \"iconUrl\": \"https://www.mtnewswires.com\",\n          \"documentation\": \"https://console.blueskyapi.com/docs/EDGE/news/MT_NEWSWIRES_Global#mcp\",\n          \"support\": \"mailto:support@vianexus.com\",\n          \"privacyPolicy\": \"https://www.mtnewswires.com/privacy-policy\",\n          \"url\": \"https://vast-mcp.blueskyapi.com/mcp\",\n          \"author\": {\n            \"name\": \"MT Newswires\",\n            \"url\": \"https://www.mtnewswires.com\"\n          },\n          \"slug\": \"mt-newswires\",\n          \"directoryUrl\": \"https://claude.ai/directory/441c79ad-8a68-4d73-9263-7cfcadd5d8cf\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http mtnewswire \",\n          \"claudeApiCopyText\": \"https://vast-mcp.blueskyapi.com/mcp\",\n          \"permissions\": \"Read and write\",\n          \"useCases\": [\n            \"financial-services\"\n          ],\n          \"worksWith\": [\n            \"claude-api\",\n            \"claude\",\n            \"claude-code\"\n          ],\n          \"publishedOn\": \"Mon Jan 12 2026 16:21:41 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Fri Oct 24 2025 19:54:30 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Mon Jan 12 2026 16:20:15 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"mt-newswires\",\n          \"serverLabel\": \"vast-mcp.blueskyapi.com/mcp\",\n          \"itemId\": \"68fbd97672e0f51086c1641d\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">MT Newswires delivers real-time, low-latency financial news across equities, fixed income, commodities, FX, and macroeconomics. Structured and machine-readable, it integrates seamlessly into AI, trading, and analytics systems, providing scalable, reliable, event-driven intelligence from MT Newswires' global newsroom trusted by leading banks, brokerages, and data providers.</p><p id=\\\"\\\">You can use the MT Newswires connector to:<br><br>Get latest news and analyze price impact:<br>\\\"What is the latest news for NVIDIA, and provide a comprehensive report if the news has had any influence on price movement?\\\"<br><br>Monitor sector developments:<br>\\\"Show me the latest fixed income news from the past hour and summarize any major developments\\\"</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"rank\": 99,\n          \"popularityScore\": 12551,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 46328\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.squareup.mcp/square\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Access Square’s commerce platform to view transaction data, manage customer profiles, track inventory, process payments, and analyze sales patterns. Handle point-of-sale operations, generate financial reports, and manage business operations through Claude’s natural language interface for streamlined commerce management.\",\n        \"title\": \"Square\",\n        \"remotes\": [\n          {\n            \"type\": \"sse\",\n            \"url\": \"https://mcp.squareup.com/sse\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"25d61b20-3ba1-4477-b51a-a743d1ca65fb\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"get_service_info\",\n            \"get_type_info\",\n            \"make_api_request\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Square\",\n          \"oneLiner\": \"Search and manage transaction, merchant, and payment data\",\n          \"iconUrl\": \"https://mcp.squareup.com/sse\",\n          \"documentation\": \"https://developer.squareup.com/docs/mcp\",\n          \"support\": \"https://developer.squareup.com/docs\",\n          \"privacyPolicy\": \"https://squareup.com/us/en/legal/general/privacy\",\n          \"url\": \"https://mcp.squareup.com/sse\",\n          \"author\": {\n            \"name\": \"Square, Inc.\",\n            \"url\": \"https://squareup.com\"\n          },\n          \"slug\": \"square\",\n          \"directoryUrl\": \"http://claude.ai/directory/25d61b20-3ba1-4477-b51a-a743d1ca65fb\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport sse square https://mcp.squareup.com/sse\\n\",\n          \"permissions\": \"Read and write\",\n          \"useCases\": [\n            \"financial-services\"\n          ],\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"publishedOn\": \"Mon Jan 12 2026 16:21:41 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Thu Aug 28 2025 14:02:57 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Mon Jan 12 2026 16:20:16 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"square\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"mcp.squareup.com\",\n          \"itemId\": \"68b06191f62d9a2435f934c5\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">Access Square's commerce platform to view transaction data, manage customer profiles, track inventory, process payments, and analyze sales patterns. Handle point-of-sale operations, generate financial reports, and manage business operations through Claude's natural language interface for streamlined commerce management.</p><p id=\\\"\\\">You can use the Square connector to:<br><br>Create invoices:<br>\\\"Create an invoice charging Jane Smith (<a id=\\\"\\\" href=\\\"mailto:jane@example.com\\\">jane@example.com</a>) for 2 hours at $250/hr for 'Consulting on the Square MCP Server'\\\"</p><p id=\\\"\\\">Update business hours:<br>\\\"Update my business hours to be 9am - 5pm Monday through Friday, 10am - 2pm on Saturday, and closed on Sunday\\\"</p><p id=\\\"\\\">Analyze sales data:<br>\\\"Tell me what my top 3 most sold items from the last month according to my orders\\\"</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2025-11-12\",\n          \"rank\": 100,\n          \"popularityScore\": 12547,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 45757,\n          \"sortOrder\": 1\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.base44/mcp\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Create, edit, and manage Base44 apps directly from Claude. Describe what you want to build and Base44 will generate a full-stack project for you — with data models, backend logic, and a working UI. Query your app's data, update entity schemas, and iterate on existing projects without ever leaving Claude. Make Base44 a native part of your AI workflow — an AI-powered app builder that turns ideas into production-ready apps, faster.\",\n        \"title\": \"Base44\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://app.base44.com/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"16ebc92d-b1db-473a-82ef-015426940c4c\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"create_base44_app\",\n            \"edit_base44_app\",\n            \"list_user_apps\",\n            \"list_entity_schemas\",\n            \"query_entities\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": false,\n          \"displayName\": \"Base44\",\n          \"oneLiner\": \"Build and manage Base44 apps\",\n          \"iconUrl\": \"https://base44.com\",\n          \"documentation\": \"https://docs.base44.com/developers/backend/overview/mcp-server\",\n          \"support\": \"https://app.base44.com/support\",\n          \"privacyPolicy\": \"https://base44.com/privacy-policy\",\n          \"url\": \"https://app.base44.com/mcp\",\n          \"author\": {\n            \"name\": \"Base44\",\n            \"url\": \"https://base44.com/\"\n          },\n          \"slug\": \"base44\",\n          \"directoryUrl\": \"https://claude.ai/directory/16ebc92d-b1db-473a-82ef-015426940c4c\",\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\"\n          ],\n          \"logo\": \"base44\",\n          \"backgroundPattern\": \"Line 1\",\n          \"serverLabel\": \"app.base44.com/mcp\",\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"useCases\": [\n            \"code\"\n          ],\n          \"permissions\": \"Read and write\",\n       