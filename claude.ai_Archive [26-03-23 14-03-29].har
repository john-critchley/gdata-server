Islands\",\"console_supported\":true,\"claudeai_supported\":true,\"phone_verification_supported\":false,\"stripe_address_supported\":false},\"US\":{\"name\":\"United States\",\"console_supported\":true,\"claudeai_supported\":true,\"phone_verification_supported\":true,\"stripe_address_supported\":true},\"UY\":{\"name\":\"Uruguay\",\"console_supported\":true,\"claudeai_supported\":true,\"phone_verification_supported\":true,\"stripe_address_supported\":true},\"UZ\":{\"name\":\"Uzbekistan\",\"console_supported\":true,\"claudeai_supported\":true,\"phone_verification_supported\":true,\"stripe_address_supported\":true},\"VA\":{\"name\":\"Vatican City\",\"console_supported\":true,\"claudeai_supported\":true,\"phone_verification_supported\":true,\"stripe_address_supported\":true},\"VC\":{\"name\":\"Saint Vincent and the Grenadines\",\"console_supported\":true,\"claudeai_supported\":true,\"phone_verification_supported\":true,\"stripe_address_supported\":true},\"VE\":{\"name\":\"Venezuela\",\"console_supported\":false,\"claudeai_supported\":false,\"phone_verification_supported\":true,\"stripe_address_supported\":true},\"VG\":{\"name\":\"British Virgin Islands\",\"console_supported\":true,\"claudeai_supported\":true,\"phone_verification_supported\":true,\"stripe_address_supported\":true},\"VI\":{\"name\":\"U.S. Virgin Islands\",\"console_supported\":true,\"claudeai_supported\":true,\"phone_verification_supported\":true,\"stripe_address_supported\":false},\"VN\":{\"name\":\"Vietnam\",\"console_supported\":true,\"claudeai_supported\":true,\"phone_verification_supported\":true,\"stripe_address_supported\":true},\"VU\":{\"name\":\"Vanuatu\",\"console_supported\":true,\"claudeai_supported\":true,\"phone_verification_supported\":true,\"stripe_address_supported\":true},\"WF\":{\"name\":\"Wallis and Futuna\",\"console_supported\":true,\"claudeai_supported\":true,\"phone_verification_supported\":true,\"stripe_address_supported\":true},\"WS\":{\"name\":\"Samoa\",\"console_supported\":true,\"claudeai_supported\":true,\"phone_verification_supported\":true,\"stripe_address_supported\":true},\"XK\":{\"name\":\"Kosovo\",\"console_supported\":false,\"claudeai_supported\":false,\"phone_verification_supported\":true,\"stripe_address_supported\":true},\"YE\":{\"name\":\"Yemen\",\"console_supported\":false,\"claudeai_supported\":false,\"phone_verification_supported\":true,\"stripe_address_supported\":true},\"YT\":{\"name\":\"Mayotte\",\"console_supported\":true,\"claudeai_supported\":true,\"phone_verification_supported\":true,\"stripe_address_supported\":true},\"ZA\":{\"name\":\"South Africa\",\"console_supported\":true,\"claudeai_supported\":true,\"phone_verification_supported\":true,\"stripe_address_supported\":true},\"ZM\":{\"name\":\"Zambia\",\"console_supported\":true,\"claudeai_supported\":true,\"phone_verification_supported\":true,\"stripe_address_supported\":true},\"ZW\":{\"name\":\"Zimbabwe\",\"console_supported\":true,\"claudeai_supported\":true,\"phone_verification_supported\":true,\"stripe_address_supported\":true}}},\"3165999318\":{\"defaultValue\":false},\"731878975\":{\"defaultValue\":{\"default\":{\"allowed\":\"always\"}}},\"2211937337\":{\"defaultValue\":false},\"3126772762\":{\"defaultValue\":false},\"1131292662\":{\"defaultValue\":true,\"rules\":[{\"id\":\"6U4NiwpkNy0omybt2lPeC4\",\"force\":true}]},\"3083259802\":{\"defaultValue\":{\"modelFallbacks\":{\"claude-opus-4-6\":{\"fallbackModelName\":\"claude-sonnet-4-20250514\",\"displayName\":\"Sonnet 4\"},\"claude-sonnet-4-6\":{\"fallbackModelName\":\"claude-sonnet-4-20250514\",\"displayName\":\"Sonnet 4\"},\"claude-sonnet-4-5-20250929\":{\"fallbackModelName\":\"claude-sonnet-4-20250514\",\"displayName\":\"Sonnet 4\"},\"claude-opus-4-20250514\":{\"fallbackModelName\":\"claude-sonnet-4-20250514\",\"displayName\":\"Sonnet 4\"},\"claude-opus-4-1-20250805\":{\"fallbackModelName\":\"claude-sonnet-4-20250514\",\"displayName\":\"Sonnet 4\"},\"claude-opus-4-5-20251101\":{\"fallbackModelName\":\"claude-sonnet-4-20250514\",\"displayName\":\"Sonnet 4\"}}}},\"3735782928\":{\"defaultValue\":true,\"rules\":[{\"id\":\"2MzRQflDLJKhC8eR9GFF0W:100.00:1\",\"force\":true}]},\"1593534342\":{\"defaultValue\":false},\"2373806698\":{\"defaultValue\":true},\"3105568308\":{\"defaultValue\":{\"value\":\"You are a text autocomplete system. Your job is to predict what the USER will type next in a chat interface.\\n\\nCRITICAL RULE: You are predicting the USER's words, NOT generating an assistant response. If your completion sounds like something an AI assistant would say, it is WRONG.\\n\\nGiven:\\n- A conversation history (may be empty for new chats)\\n- A partial message the user is currently typing\\n\\nOutput:\\n- The most likely continuation (1-5 words)\\n- Include a leading space if starting a new word\\n- No leading space if completing a partial word or adding punctuation\\n- Output NOTHING (empty <completion> tags) if you're not confident\\n\\n<examples>\\n<example>\\n<conversation>\\nUser: I'm thinking about going to the beach this weekend.\\nAssistant: That sounds fun! What beach are you considering?\\n</conversation>\\n<partial>What's the weather usually</partial>\\n<completion> like there?</completion>\\n<note>Space before \\\"like\\\" because \\\"usually\\\" is a complete word.</note>\\n</example>\\n\\n<example>\\n<conversation>\\nUser: Can you help me with Python?\\nAssistant: Of course! What do you need help with?\\n</conversation>\\n<partial>I'm trying to underst</partial>\\n<completion>and how</completion>\\n<note>No space - continuing the word \\\"understand\\\".</note>\\n</example>\\n\\n<example>\\n<conversation>\\nUser: What's the capital of France?\\nAssistant: The capital of France is Paris.\\n</conversation>\\n<partial>How many people live there</partial>\\n<completion>?</completion>\\n<note>No space before punctuation.</note>\\n</example>\\n\\n<example>\\n<conversation>\\nUser: Tell me about machine learning.\\nAssistant: Machine learning is a branch of AI where systems learn from data.\\n</conversation>\\n<partial>Thanks</partial>\\n<completion>!</completion>\\n<note>User saying \\\"Thanks!\\\" - just punctuation.</note>\\n</example>\\n\\n<example>\\n<conversation>\\nUser: What's 2+2?\\nAssistant: 2+2 equals 4.\\n</conversation>\\n<partial>Thanks</partial>\\n<wrong> for explaining that!</wrong>\\n<why_wrong>This sounds like the user, but is too presumptuous about what they'll say.</why_wrong>\\n<completion>!</completion>\\n<note>When uncertain, complete minimally or not at all.</note>\\n</example>\\n\\n<example>\\n<conversation>\\nUser: Hi!\\nAssistant: Hello! How can I help you today?\\n</conversation>\\n<partial>I want to</partial>\\n<completion></completion>\\n<note>Too ambiguous - could be anything. Output nothing.</note>\\n</example>\\n\\n<example>\\n<conversation>\\nUser: Can you explain recursion?\\nAssistant: Recursion is when a function calls itself.\\n</conversation>\\n<partial>I see</partial>\\n<wrong>, that makes sense!</wrong>\\n<why_wrong>Presuming the user's reaction. They might disagree or have questions.</why_wrong>\\n<completion></completion>\\n<note>User's next thought is unpredictable here.</note>\\n</example>\\n\\n<example>\\n<conversation>\\nUser: What's the weather in Paris?\\nAssistant: It's currently 72°F and sunny in Paris.\\n</conversation>\\n<partial>What about in Lon</partial>\\n<completion>don?</completion>\\n<note>Completing \\\"London\\\" - obvious city name continuation.</note>\\n</example>\\n\\n<example>\\n<conversation></conversation>\\n<partial>How do I</partial>\\n<completion></completion>\\n<note>New chat with no context - too many possibilities. Output nothing.</note>\\n</example>\\n\\n<example>\\n<conversation></conversation>\\n<partial>What is the capital of Franc</partial>\\n<completion>e?</completion>\\n<note>Even without history, \\\"France\\\" is the obvious completion.</note>\\n</example>\\n\\n<example>\\n<conversation>\\nUser: Help me write an email.\\nAssistant: Sure! What's the email about?\\n</conversation>\\n<partial>It's for my b</partial>\\n<completion>oss</completion>\\n<note>Common word completion, but stop early - don't presume more.</note>\\n</example>\\n</examples>\\n\\nRULES:\\n1. You complete the USER's message, never generate an assistant response\\n2. Include the space in your output if needed (don't use Yes/No prefixes)\\n3. Output empty <completion></completion> if:\\n   - The partial could go many directions\\n   - You're less than ~80% confident\\n   - There's no conversation history AND the partial is ambiguous\\n4. Prefer shorter completions when uncertain\\n5. Common patterns to complete: finishing words, adding punctuation, obvious next words\\n6. Never complete with phrases like \\\"thank you for...\\\", \\\"I understand...\\\", \\\"that makes sense...\\\" - these assume user sentiment\\n\\n\"}},\"2653195130\":{\"defaultValue\":false},\"3202836592\":{\"defaultValue\":true,\"rules\":[{\"id\":\"1GZXGukeEV3XcIKck5gFVV\",\"force\":true}]},\"4185146404\":{\"defaultValue\":false},\"3390825040\":{\"defaultValue\":true,\"rules\":[{\"id\":\"48vIPf08ZpC86M5JPd92mP:100.00:1\",\"force\":true}]},\"3185228871\":{\"defaultValue\":{\"unsupported_models\":[\"claude-3-5-sonnet-20240620\",\"claude-3-opus-20240229\",\"claude-3-5-sonnet-20241022\",\"claude-3-5-haiku-20241022\"]}},\"951697313\":{\"defaultValue\":{}},\"3027583583\":{\"defaultValue\":false},\"3704139687\":{\"defaultValue\":{\"max_free_projects\":5},\"rules\":[{\"id\":\"NnRcFjyR29jpnQ4xRvGRH\",\"force\":{\"max_free_projects\":5}}]},\"1950521664\":{\"defaultValue\":false},\"1033048435\":{\"defaultValue\":false},\"1689866995\":{\"defaultValue\":false},\"3939926815\":{\"defaultValue\":false},\"1258163294\":{\"defaultValue\":true,\"rules\":[{\"id\":\"2jSDZEXSCQkiZ0xvW61ydz\",\"force\":true}]},\"468759595\":{\"defaultValue\":true,\"rules\":[{\"id\":\"32H21y98WLIeIHWgVOgCY5:100.00:2\",\"force\":true}]},\"304458538\":{\"defaultValue\":{\"enabled\":\"disabled\"}},\"672949224\