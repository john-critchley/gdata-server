ntation\": \"https://docs.similarweb.com/api-v5/mcp/mcp-setup\",\n          \"support\": \"mailto:support@similarweb.com\",\n          \"privacyPolicy\": \"https://www.similarweb.com/corp/legal/privacy-policy/\",\n          \"url\": \"https://mcp.similarweb.com\",\n          \"author\": {\n            \"name\": \"Similarweb\",\n            \"url\": \"https://similarweb.com\"\n          },\n          \"slug\": \"similarweb\",\n          \"directoryUrl\": \"https://claude.ai/directory/80862d08-1022-4d86-816d-ee9b500d6b90\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http similarweb https://mcp.similarweb.com\\n\",\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"source\": \"manual\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-01-23\",\n          \"useCases\": [\n            \"productivity\"\n          ],\n          \"rank\": 77,\n          \"popularityScore\": 13794,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 71493\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.crypto.mcp/crypto-com\",\n        \"version\": \"1.0.0\",\n        \"description\": \"Real time price quotes, order books, conversions, candlestick charts and more for cryptocurrency tokens from Crypto.com\",\n        \"title\": \"Crypto.com\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.crypto.com/market-data/mcp\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"7248e592-d083-435e-9617-aebab348fe30\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"get_trades\",\n            \"get_mark_price\",\n            \"get_instruments\",\n            \"get_instrument\",\n            \"get_index_price\",\n            \"Get_candlestick\",\n            \"Get_tickers\",\n            \"Get_ticker\",\n            \"Get_book\"\n          ],\n          \"promptNames\": [],\n          \"isAuthless\": true,\n          \"displayName\": \"Crypto.com\",\n          \"oneLiner\": \"Real time prices, orders, charts, and more for crypto\",\n          \"iconUrl\": \"https://crypto.com\",\n          \"documentation\": \"https://mcp.crypto.com/docs\",\n          \"support\": \"https://help.crypto.com/en/\",\n          \"privacyPolicy\": \"https://crypto.com/privacy/en\",\n          \"url\": \"https://mcp.crypto.com/market-data/mcp\",\n          \"author\": {\n            \"name\": \"Crypto.com\",\n            \"url\": \"https://crypto.com\"\n          },\n          \"slug\": \"crypto-com\",\n          \"directoryUrl\": \"https://claude.ai/directory/7248e592-d083-435e-9617-aebab348fe30\",\n          \"claudeCodeCopyText\": \"claude mcp add --transport http crypto.com https://mcp.crypto.com/market-data/mcp\",\n          \"permissions\": \"Read\",\n          \"worksWith\": [\n            \"claude\",\n            \"claude-api\",\n            \"claude-code\"\n          ],\n          \"publishedOn\": \"Mon Jan 12 2026 16:21:41 GMT+0000 (Coordinated Universal Time)\",\n          \"createdOn\": \"Mon Nov 24 2025 01:42:44 GMT+0000 (Coordinated Universal Time)\",\n          \"updatedOn\": \"Mon Jan 12 2026 16:20:15 GMT+0000 (Coordinated Universal Time)\",\n          \"logo\": \"crypto-com\",\n          \"serverLabel\": \"mcp.crypto.com/market-data/mcp\",\n          \"itemId\": \"6923b8143e4fc54d2296e40d\",\n          \"collectionId\": \"68b05e2de975b4de7dd02d9d\",\n          \"localeId\": \"68a44d4040f98a4adf2207b5\",\n          \"htmlContent\": \"<p id=\\\"\\\">Real time price quotes, order books, conversions, candlestick charts and more for cryptocurrency tokens from Crypto.com<br>‍<br>You can use the Crypto.com connector to:</p><p id=\\\"\\\">Check Cryptocurrency Prices:<strong id=\\\"\\\"><br>‍</strong>\\\"What is the price of Bitcoin?\\\"</p><p id=\\\"\\\">Track Daily Price Changes:<strong id=\\\"\\\"><br>‍</strong>\\\"How much has Ethereum gained today?\\\"</p><p id=\\\"\\\">View Trading Volume:<strong id=\\\"\\\"><br>‍</strong>\\\"How much SOL has been bought and sold today?\\\"</p>\",\n          \"source\": \"auto-sync\",\n          \"visibility\": [\n            \"commercial\"\n          ],\n          \"added_at\": \"2026-01-08\",\n          \"useCases\": [\n            \"financial-services\"\n          ],\n          \"rank\": 78,\n          \"popularityScore\": 13708,\n          \"scoreVersion\": \"v1\",\n          \"trendingScore\": 54802\n        },\n        \"io.modelcontextprotocol.registry/official\": {\n          \"status\": \"active\",\n          \"isLatest\": true\n        }\n      }\n    },\n    {\n      \"server\": {\n        \"name\": \"com.postman/postman-mcp-server\",\n        \"version\": \"2.8.2\",\n        \"description\": \"With Postman's MCP server, you can prompt AI to automate work across your Postman collections, environments, workspaces, and more.\",\n        \"title\": \"Postman\",\n        \"remotes\": [\n          {\n            \"type\": \"streamable-http\",\n            \"url\": \"https://mcp.postman.com/minimal\"\n          }\n        ]\n      },\n      \"_meta\": {\n        \"com.anthropic.api/mcp-registry\": {\n          \"uuid\": \"b9049585-f39b-45e8-8626-6ca78d9d7d22\",\n          \"type\": \"remote\",\n          \"toolNames\": [\n            \"createCollection\",\n            \"updateCollection\",\n            \"deleteCollection\",\n            \"getCollection\",\n            \"getAllCollections\",\n            \"createFolder\",\n            \"updateFolder\",\n            \"deleteFolder\",\n            \"getFolder\",\n            \"createRequest\",\n            \"updateRequest\",\n            \"dele