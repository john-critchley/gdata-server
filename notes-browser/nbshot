#!/usr/bin/env python3
"""nbshot — drive the notes-browser control socket.

Navigate the running notes browser to a note and capture its content
off-screen (no window raise, no focus theft, full page — uses
ui.capture_content).

Usage:
    nbshot <note-key> [out.png]        navigate + capture (default out ~/tmp/nbshot.png)
    nbshot --rpc <method> [json-params] send any control method, print the reply
    nbshot --caps                      list available control methods

Env:
    NOTES_BROWSER_SOCK   socket path (default ~/tmp/notes-browser.sock)
"""
import json
import os
import socket
import sys

SOCK = os.environ.get("NOTES_BROWSER_SOCK", os.path.expanduser("~/tmp/notes-browser.sock"))


def rpc(method, params=None, timeout=20.0):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(SOCK)
    except OSError as e:
        sys.exit(f"nbshot: cannot connect to {SOCK}: {e}\n"
                 "Is the notes browser running with --control-unix-socket?")
    s.sendall((json.dumps({"jsonrpc": "2.0", "id": 1, "method": method,
                           "params": params or {}}) + "\n").encode())
    buf = b""
    while True:
        chunk = s.recv(4096)
        if not chunk:
            break
        buf += chunk
        try:
            return json.loads(buf.decode())
        except json.JSONDecodeError:
            continue
    raise RuntimeError(f"no valid response: {buf!r}")


def _check(reply, what):
    if isinstance(reply, dict) and reply.get("error"):
        sys.exit(f"nbshot: {what} failed: {reply['error']}")
    return reply


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0

    if argv[0] == "--caps":
        print(json.dumps(_check(rpc("status.capabilities"), "capabilities")
                         .get("result", {}), indent=2))
        return 0

    if argv[0] == "--rpc":
        method = argv[1]
        params = json.loads(argv[2]) if len(argv) > 2 else {}
        print(json.dumps(rpc(method, params), indent=2))
        return 0

    key = argv[0]
    out = os.path.expanduser(argv[1] if len(argv) > 1 else "~/tmp/nbshot.png")
    out = os.path.abspath(out)
    _check(rpc("navigate.go_to_page", {"key": key}), "navigate")
    reply = _check(rpc("ui.capture_content", {"path": out}), "capture")
    print(reply["result"]["path"])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
