#!/usr/bin/env python3
"""
Load JSON files from zip archives into the notes system.

Usage: load_notes file1.zip [file2.zip ...]

File naming convention:
- Remove .json extension
- _root.json -> "" (root node)
- _ converts to / (e.g., README_keys.json -> README/keys)
"""

import sys
import os
import zipfile
import json
import subprocess
import tempfile

def filename_to_node_name(filename):
    """Convert filename to node name according to the rules."""
    # Remove .json extension
    if filename.endswith('.json'):
        name = filename[:-5]
    else:
        name = filename
    
    # _root becomes empty string (root node)
    if name == '_root':
        return ''
    
    # Convert _ to /
    return name.replace('_', '/')

def load_json_to_notes(node_name, json_content):
    """Load JSON content into notes using the notes command."""
    try:
        # Use notes write-stdin to load the content
        process = subprocess.run(
            ['notes', 'write-stdin', node_name],
            input=json_content,
            text=True,
            capture_output=True,
            check=True
        )
        print(f"✓ Loaded: '{node_name}'")
        return True
    except subprocess.CalledProcessError as e:
        print(f"✗ Failed to load '{node_name}': {e}")
        if e.stderr:
            print(f"  Error: {e.stderr}")
        return False

def process_zip_file(zip_path):
    """Process all JSON files in a zip archive."""
    print(f"Processing {zip_path}...")
    
    try:
        with zipfile.ZipFile(zip_path, 'r') as zf:
            # Get list of JSON files
            json_files = [name for name in zf.namelist() 
                         if name.endswith('.json') and not name.startswith('.')]
            
            if not json_files:
                print(f"  No JSON files found in {zip_path}")
                return 0
            
            success_count = 0
            
            for filename in json_files:
                # Skip build_notes.py and other non-JSON files
                if not filename.endswith('.json'):
                    continue
                
                node_name = filename_to_node_name(filename)
                
                try:
                    # Read JSON content from zip
                    json_content = zf.read(filename).decode('utf-8')
                    
                    # Validate it's proper JSON
                    json.loads(json_content)
                    
                    # Load into notes
                    if load_json_to_notes(node_name, json_content):
                        success_count += 1
                        
                except json.JSONDecodeError as e:
                    print(f"✗ Invalid JSON in '{filename}': {e}")
                except Exception as e:
                    print(f"✗ Error processing '{filename}': {e}")
            
            print(f"  Loaded {success_count}/{len(json_files)} files from {zip_path}")
            return success_count
            
    except zipfile.BadZipFile:
        print(f"✗ Invalid zip file: {zip_path}")
        return 0
    except Exception as e:
        print(f"✗ Error processing {zip_path}: {e}")
        return 0

def main():
    if len(sys.argv) < 2:
        print("Usage: load_notes file1.zip [file2.zip ...]")
        print()
        print("Loads JSON files from zip archives into the notes system.")
        print()
        print("File naming convention:")
        print("  - Remove .json extension")
        print("  - _root.json -> '' (root node)")
        print("  - _ converts to / (e.g., README_keys.json -> README/keys)")
        sys.exit(1)
    
    zip_files = sys.argv[1:]
    total_loaded = 0
    
    # Check if notes command is available
    try:
        subprocess.run(['notes', 'list'], capture_output=True, check=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        print("✗ Error: 'notes' command not found or not working")
        print("  Make sure the gdata server is running and notes client is available")
        sys.exit(1)
    
    for zip_path in zip_files:
        if not os.path.exists(zip_path):
            print(f"✗ File not found: {zip_path}")
            continue
            
        loaded = process_zip_file(zip_path)
        total_loaded += loaded
    
    print(f"\nTotal: {total_loaded} documents loaded successfully")
    
    # List current nodes to show what's available
    print("\nCurrent documents:")
    try:
        result = subprocess.run(['notes', 'list'], capture_output=True, text=True, check=True)
        print(result.stdout)
    except subprocess.CalledProcessError:
        print("  (Could not list documents)")

if __name__ == '__main__':
    main()